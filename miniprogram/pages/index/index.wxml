<view class="container theme-{{theme}}">
  <!-- 地球装饰 -->
  <view class="earth-orb" style="left: {{earthLeft}}rpx; top: {{earthTop}}rpx;">
    <image class="earth-img" src="/assets/earth.png" mode="aspectFit"/>
  </view>
  <!-- 主题切换过渡动画 -->
  <view class="theme-transition {{themeTransing ? 'active' : ''}}" wx:if="{{themeTransing}}">
    <view class="transit-ball transit-out {{theme === 'dark' ? 'is-moon' : 'is-sun'}}"></view>
    <view class="transit-ball transit-in {{theme === 'dark' ? 'is-sun' : 'is-moon'}}"></view>
  </view>
  <!-- 背景光球 -->
  <view class="bg-layer">
    <view class="orb orb-cyan"></view>
    <view class="orb orb-purple"></view>
  </view>

  <!-- 随机亮点 -->
  <view class="dots-layer">
    <view class="dot" wx:for="{{dots}}" wx:key="index" style="left: {{item.x}}rpx; top: {{item.y}}rpx; width: {{item.s}}rpx; height: {{item.s}}rpx; animation-delay: {{item.d}}s; opacity: {{item.o}};"></view>
  </view>

  <!-- 用户信息 -->
  <view class="user-bar">
    <image class="user-avatar" src="{{avatar}}" mode="aspectFill" wx:if="{{avatar}}"/>
    <view class="user-avatar placeholder" wx:else></view>
    <view class="user-info">
      <text class="user-name">{{nickname || '未登录'}}</text>
    </view>
    <!-- 日/夜间切换按钮 -->
    <view class="theme-toggle {{theme === 'dark' ? 'is-light' : ''}}" bindtap="onToggleTheme">
      <view class="toggle-circle">
        <view class="toggle-sun">
          <view class="toggle-moon">
            <view class="moon-crater"></view>
            <view class="moon-crater"></view>
            <view class="moon-crater"></view>
          </view>
        </view>
      </view>
      <view class="toggle-clouds"></view>
      <view class="toggle-stars">
        <view class="stars-dot" wx:for="{{starDots}}" wx:key="index"
          style="left: {{item.left}}%; top: {{item.top}}%; animation-delay: {{item.delay}}s; --peak: {{item.peak}};"></view>
      </view>
    </view>
  </view>
  <!-- 状态和提醒（独立于 user-bar，不挤占头像位置） -->
  <view class="user-status" wx:if="{{passcodeStatusText || inactiveDays > 1}}">
    <view class="status-row" wx:if="{{passcodeStatusText}}">
      <view class="status-dot" style="background: {{passcodeStatusColor}}"></view>
      <text class="passcode-status">{{passcodeStatusText}}</text>
    </view>
    <text class="inactive-reminder" wx:if="{{inactiveDays > 1}}">距离上次游泳已经 {{inactiveDays}} 天了，池子在想你</text>
  </view>

  <!-- 标题 -->
  <view class="hero">
    <text class="hero-title">得闲意</text>
    <text class="hero-sub">行到水穷处，坐看云起时</text>
  </view>

  <!-- 入口宫格 -->
  <view class="grid">
    <view class="card" style="animation-delay: 0.1s" bindtap="goSwim">
      <view class="card-icon">🏊</view>
      <text class="card-title">获取游泳票</text>
      <text class="card-desc">通行码验证 · 获取入场凭证</text>
      <view class="card-clock {{theme === 'light' ? 'cc-light' : ''}}">{{clockTime}}</view>
    </view>
    <view class="card-row" style="animation-delay: 0.3s">
      <view class="card card-half" bindtap="goMine">
        <view class="card-icon">📅</view>
        <text class="card-title">我的</text>
        <text class="card-desc">打卡记录 · 游泳统计</text>
      </view>
      <view class="card card-half" style="animation-delay: 0.4s" bindtap="goAdmin">
        <view class="card-icon">⚙️</view>
        <text class="card-title">后台管理</text>
        <text class="card-desc">配置管理 · 数据统计</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>得闲时 · 意自在</text>
    <text class="feedback-link" bindtap="goFeedback">💬 意见反馈</text>
  </view>

</view>
