.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  position: relative;
  overflow: hidden;
  background: var(--bg-gradient, var(--bg));
}
.theme-light.container { background: linear-gradient(160deg, #016B61 0%, #70B2B2 40%, #9ECFD4 70%, #E5E9C5 100%); }

/* ── 背景光球 ── */
.bg-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
}
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.3;
}
.orb-cyan {
  width: 400rpx; height: 400rpx;
  top: 10%; left: -100rpx;
  background: rgba(6, 182, 212, 0.7);
}
.orb-purple {
  width: 360rpx; height: 360rpx;
  bottom: 20%; right: -80rpx;
  background: rgba(139, 92, 246, 0.6);
}
@keyframes float-cyan {
  0% { transform: translate(0, 0); }
  100% { transform: translate(40rpx, -24rpx); }
}
@keyframes float-purple {
  0% { transform: translate(0, 0); }
  100% { transform: translate(-24rpx, 40rpx); }
}

/* ── 随机亮点 ── */
.dots-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
}
.dot {
  position: absolute;
  border-radius: 50%;
  background: var(--accent);
  animation: twinkle 3s ease-in-out infinite alternate;
}
@keyframes twinkle {
  0% { transform: scale(0.4); opacity: 0.15; }
  100% { transform: scale(1.2); opacity: 0.6; }
}

/* ── 地球装饰 ── */
.earth-orb {
  position: fixed;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  z-index: 0;
  animation: earth-float 6s ease-in-out infinite alternate;
}

.earth-img {
  width: 100%;
  height: 100%;
}

@keyframes earth-float {
  0% { transform: translate(0, 0); }
  100% { transform: translate(-6rpx, -10rpx); }
}

/* ── 时段提示弹窗 ── */
.timetip-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: timetip-in 0.3s ease-out forwards;
}
.timetip-overlay.out {
  animation: timetip-out 0.25s ease-in forwards;
}
@keyframes timetip-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes timetip-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
.timetip-card {
  position: relative;
  background: linear-gradient(160deg, #0a1628 0%, #0f1f38 100%);
  border: 2rpx solid rgba(6, 182, 212, 0.6);
  border-radius: 16rpx;
  padding: 48rpx 56rpx;
  text-align: center;
  overflow: hidden;
  box-shadow: 0 0 40rpx rgba(6, 182, 212, 0.4), 0 0 80rpx rgba(6, 182, 212, 0.2), inset 0 0 40rpx rgba(6, 182, 212, 0.08);
}
.timetip-noise {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: repeating-linear-gradient(
    0deg, transparent, transparent 3rpx, rgba(6, 182, 212, 0.3) 3rpx, rgba(6, 182, 212, 0.3) 4rpx,
    transparent 4rpx, transparent 12rpx
  );
  animation: noise-flicker 0.12s steps(3) infinite;
  pointer-events: none;
}
@keyframes noise-flicker {
  0% { opacity: 0.03; transform: translateY(0); }
  33% { opacity: 0.12; transform: translateY(-2rpx); }
  66% { opacity: 0.05; transform: translateY(3rpx); }
  100% { opacity: 0.08; transform: translateY(-1rpx); }
}
.timetip-scanline {
  position: absolute;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 3%, rgba(6, 182, 212, 0.5) 20%, rgba(200, 240, 255, 0.9) 50%, rgba(6, 182, 212, 0.5) 80%, transparent 97%);
  pointer-events: none;
  box-shadow: 0 0 8rpx rgba(6, 182, 212, 0.5);
}
.timetip-scanline.s1 { left: 8%; width: 55%; animation: glitch-line-1 1.6s steps(8) infinite; }
.timetip-scanline.s2 { left: 35%; width: 45%; animation: glitch-line-2 2.1s steps(8) infinite; }
.timetip-scanline.s3 { left: 5%; width: 70%; animation: glitch-line-3 1.8s steps(8) infinite; }
@keyframes glitch-line-1 {
  0%, 14% { top: 20%; opacity: 0; }
  16% { top: 20%; opacity: 1; }
  18% { top: 22%; opacity: 0.6; }
  19% { top: 22%; opacity: 0; }
  44% { top: 65%; opacity: 0; }
  46% { top: 65%; opacity: 1; }
  47% { top: 63%; opacity: 0.8; }
  48% { top: 67%; opacity: 0; }
  72% { top: 38%; opacity: 0; }
  74% { top: 38%; opacity: 0.9; }
  76% { top: 40%; opacity: 0; }
  90% { top: 85%; opacity: 0; }
  92% { top: 85%; opacity: 1; }
  93% { top: 83%; opacity: 0.5; }
  94% { top: 87%; opacity: 0; }
  100% { top: 85%; opacity: 0; }
}
@keyframes glitch-line-2 {
  0%, 24% { top: 45%; opacity: 0; }
  26% { top: 45%; opacity: 0.9; }
  27% { top: 48%; opacity: 0.7; }
  28% { top: 43%; opacity: 0; }
  54% { top: 12%; opacity: 0; }
  56% { top: 12%; opacity: 1; }
  58% { top: 14%; opacity: 0; }
  78% { top: 75%; opacity: 0; }
  80% { top: 75%; opacity: 0.8; }
  82% { top: 73%; opacity: 0; }
  94% { top: 30%; opacity: 0; }
  96% { top: 30%; opacity: 1; }
  97% { top: 32%; opacity: 0.5; }
  98% { top: 28%; opacity: 0; }
  100% { top: 30%; opacity: 0; }
}
@keyframes glitch-line-3 {
  0%, 32% { top: 55%; opacity: 0; }
  34% { top: 55%; opacity: 1; }
  35% { top: 58%; opacity: 0.6; }
  36% { top: 52%; opacity: 0; }
  62% { top: 18%; opacity: 0; }
  64% { top: 18%; opacity: 0.85; }
  66% { top: 20%; opacity: 0; }
  84% { top: 70%; opacity: 0; }
  86% { top: 70%; opacity: 1; }
  87% { top: 68%; opacity: 0.7; }
  88% { top: 72%; opacity: 0; }
  96% { top: 48%; opacity: 0; }
  98% { top: 48%; opacity: 0.9; }
  99% { top: 50%; opacity: 0; }
  100% { top: 48%; opacity: 0; }
}
.timetip-text {
  font-size: 38rpx;
  font-weight: 700;
  color: #06b6d4;
  line-height: 1.8;
  white-space: pre-line;
  text-shadow: 0 0 20rpx rgba(6, 182, 212, 0.3);
  letter-spacing: 2rpx;
}

/* ── 联系国哥二维码弹窗 ── */
.qr-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qr-modal-card {
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  width: 500rpx;
}
.qr-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 32rpx;
}
.qr-modal-img {
  width: 100%;
  border-radius: 12rpx;
}

/* ── 出票动画 ── */
/* 遮罩背景（独立，淡出不影子女） */
.ticket-overlay-bg {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 500;
  background: rgba(0,0,0,0.5);
  opacity: 1;
}
.ticket-overlay-bg.overlay-fading {
  opacity: 0;
  transition: opacity 0.6s ease-in;
}

/* 出票口裁剪 */
.ticket-slot {
  position: fixed;
  top: calc(50% - 180rpx);
  left: 50%;
  transform: translateX(-50%);
  width: 560rpx;
  height: 360rpx;
  overflow: hidden;
  z-index: 501;
}

.ticket-card {
  width: 560rpx;
  background: linear-gradient(160deg, #6b4e3d 0%, #5a4fa0 25%, #3a3a52 50%, #2d5a65 75%, #059699 100%);
  border-radius: 32rpx;
  padding: 32rpx 48rpx;
  text-align: left;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
/* 虚线撕口 */
.ticket-rip {
  position: absolute;
  left: 160rpx;
  top: 20rpx;
  bottom: 20rpx;
  width: 0;
  border-left: 2rpx dashed rgba(255,255,255,0.2);
}
	/* 虚线两端半圆齿孔 */
.ticket-card::before {
  content: '';
  position: absolute;
	  left: calc(160rpx - 16rpx);
	  top: -16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
	  background: rgba(0,0,0,0.6);

}
.ticket-card::after {
  content: '';
  position: absolute;
	  left: calc(160rpx - 16rpx);
	  bottom: -16rpx;
  width: 32rpx;
  height: 32rpx;
	  background: rgba(0,0,0,0.6);
  border-radius: 50%;

}
/* 票号 */
.ticket-card .ticket-no {
  font-size: 20rpx;
  color: #999;
  text-align: right;
  margin-bottom: 16rpx;
}

.ticket-pool {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 32rpx;
  display: block;
}

.ticket-cred {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.ticket-label {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}
.ticket-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  font-family: monospace;
}

.ticket-card.print {
  animation: ticket-print 1.2s ease-out forwards;
}

@keyframes ticket-print {
  0% { transform: translateY(-100%); opacity: 0; }
  20% { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(0); opacity: 1; }
}

/* 收缩阶段：允许卡片飞出裁剪区 */
.ticket-slot.slot-shrink {
  overflow: visible;
}

/* 收缩阶段：槽位允许溢出，重置动画让 inline transition 生效 */
.ticket-card.shrink {
  animation: none;
}

.ticket-pool {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 32rpx;
  display: block;
}

.ticket-label {
  font-size: 36rpx;
  color: rgba(255,255,255,0.5);
}
.ticket-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  font-family: monospace;
}

/* ── 票根按钮（虚线左侧存根样式）── */
.ticket-stub {
  position: fixed;
  right: 0;
  top: 480rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(160deg, #6b4e3d 0%, #5a4fa0 60%, #3a3a52 100%);
  border-radius: 12rpx 0 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 400;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.35);
  /* 右边虚线撕口 */
  border-right: 2rpx dashed rgba(255,255,255,0.3);
}
/* 虚线两端半圆齿孔 */
.ticket-stub::before {
  content: '';
  position: absolute;
  right: -12rpx;
  top: -8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--bg);
}
.ticket-stub::after {
  content: '';
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--bg);
}
.stub-count {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

/* ── 核销输入弹窗 ── */
.redeem-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.redeem-card {
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 520rpx;
}
.redeem-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  display: block;
  margin-bottom: 32rpx;
}
.redeem-input {
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.15);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
  text-align: center;
}
.redeem-buttons {
  display: flex;
  gap: 20rpx;
}
.redeem-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.redeem-btn.cancel {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.7);
}
.redeem-btn.confirm {
  background: linear-gradient(135deg, var(--accent), #3b82f6);
  color: #fff;
}
.redeem-btn.confirm[disabled] {
  opacity: 0.4;
}

/* ── 票列表弹窗 ── */
.ticket-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 600;
}
.ticket-modal-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  animation: modal-bg-in 0.3s ease-out;
}
@keyframes modal-bg-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
/* 关闭时背景淡出 */
.ticket-modal.closing .ticket-modal-bg {
  animation: modal-bg-out 0.35s ease-in forwards;
}
@keyframes modal-bg-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
.ticket-modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  max-height: 80vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.ticket-modal-content::-webkit-scrollbar {
  display: none;
}

.ticket-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  display: block;
  margin-bottom: 32rpx;
}

.ticket-card-full {
  background: linear-gradient(160deg, #6b4e3d 0%, #5a4fa0 25%, #3a3a52 50%, #2d5a65 75%, #059699 100%);
  border-radius: 32rpx;
  padding: 32rpx 48rpx;
  margin-bottom: 24rpx;
  text-align: left;
  position: relative;
  animation: ticket-item-in 0.4s ease-out backwards;
}
@keyframes ticket-item-in {
  from {
    opacity: 0;
    transform: translateY(80rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
/* 核销时 item 右滑淡出 */
.ticket-card-full.removing {
  animation: ticket-item-redeem 0.35s ease-in forwards !important;
}
@keyframes ticket-item-redeem {
  from {
    opacity: 1;
    transform: translateX(0);
  }
  to {
    opacity: 0;
    transform: translateX(120rpx);
  }
}

/* 关闭时 item 下落淡出 */
.ticket-modal.closing .ticket-card-full {
  animation: ticket-item-out 0.3s ease-in forwards !important;
}
@keyframes ticket-item-out {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(60rpx);
  }
}
.ticket-card-full::before {
  content: '';
  position: absolute;
  left: -22rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--modal-bg);
  transform: translateY(-50%);
}
.ticket-card-full::after {
  content: '';
  position: absolute;
  right: -22rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--modal-bg);
  transform: translateY(-50%);
}
.ticket-card-full .ticket-pool { font-size: 36rpx; }
.ticket-time {
  font-size: 22rpx;
  color: var(--text-dim);
  margin-top: 16rpx;
}
.ticket-redeem {
  margin-top: 20rpx;
  padding: 18rpx 12rpx;
  background: linear-gradient(135deg, var(--accent), #3b82f6);
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
.ticket-modal-close {
  text-align: center;
  font-size: 28rpx;
  color: var(--text-dim);
  padding: 24rpx;
}

/* ── 用户栏 ── */
.user-bar {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  width: 100%;
  margin-top: 92rpx;
}
.user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.user-avatar.placeholder {
  background: var(--border);
}
.user-info {
  display: flex;
  flex-direction: column;
}
.user-name {
  font-size: 26rpx;
  color: var(--text-dim);
}
.status-row {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 8rpx;
  position: relative;
}
.status-dot::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: inherit;
  opacity: 0.4;
  animation: pulse-glow 2s ease-in-out infinite;
}
@keyframes pulse-glow {
  0%, 100% { transform: scale(0.6); opacity: 0.15; }
  50% { transform: scale(1.6); opacity: 0.4; }
}
.passcode-status {
  font-size: 22rpx;
  color: var(--text-dim);
}
.inactive-reminder {
  font-size: 22rpx;
  color: #fbbf24;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ── 用户状态（绝对定位，不影响页面布局） ── */
.user-status {
  position: absolute;
  z-index: 10;
  left: 48rpx;
  right: 48rpx;
  top: 160rpx;
  pointer-events: none;
}

/* ── 标题 ── */
.hero {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
  text-align: center;
}
.hero-title {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #06b6d4, #818cf8, #c084fc, #f472b6, #c084fc, #818cf8, #06b6d4);
  background-size: 300% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 24rpx;
  animation: marquee 8s linear infinite;
  filter: drop-shadow(0 0 32rpx rgba(34, 211, 238, 0.25));
}
@keyframes marquee {
  0% { background-position: 150% 0; }
  100% { background-position: -150% 0; }
}
.hero-sub {
  font-size: 26rpx;
  color: var(--text-dim);
  letter-spacing: 4rpx;
}

.theme-light .card,
.theme-light .card-half { background: rgba(255,255,255,0.45); }
.theme-light .user-name { color: rgba(255,255,255,0.85); }
.theme-light .hero-title {
  background: linear-gradient(135deg, #F83600, #F98512, #F9D423, #F98512, #F83600);
  background-size: 300% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: marquee 8s linear infinite;
  filter: drop-shadow(0 0 24rpx rgba(249,133,18,0.35));
}
.theme-light .hero-sub {
  color: rgba(255,255,255,0.75);
}

/* ── 入口宫格 ── */
.grid {
  position: relative;
  z-index: 1;
  margin-top: 80rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
  width: 100%;
}
.card {
  flex: 1 1 280rpx;
  min-width: 260rpx;
  background: var(--bg-card2);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all 0.2s;
  opacity: 0;
  transform: translateY(40rpx);
  animation: card-in 0.6s ease-out forwards;
  position: relative;
  overflow: hidden;
}
@keyframes card-in {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.card:active {
  background: rgba(6,182,212,0.1);
  border-color: var(--accent-border);
  transform: scale(0.96) !important;
}
/* ── 卡片行 ── */
.card-row {
  display: flex;
  gap: 32rpx;
  width: 100%;
  opacity: 0;
  animation: card-in 0.6s ease-out forwards;
}
.card-half {
  flex: 1;
  min-width: 0;
  position: relative;
  animation: none;
  opacity: 1;
  transform: none;
}

.card-icon { font-size: 56rpx; margin-bottom: 24rpx; position: relative; z-index: 1; }
.card-title { font-size: 32rpx; font-weight: 600; color: var(--text); margin-bottom: 12rpx; position: relative; z-index: 1; }
.card-desc { font-size: 24rpx; color: var(--text-dim); position: relative; z-index: 1; }
.card-badge { position: absolute; top: 12rpx; right: 12rpx; min-width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; font-size: 20rpx; font-weight: 700; color: #fff; background: #ef4444; border-radius: 18rpx; padding: 0 8rpx; z-index: 2; }
.card-clock {
  position: absolute;
  top: -48rpx; left: -32rpx; right: -32rpx; bottom: -48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 200rpx;
  font-weight: 700;
  font-family: SimHei, 'PingFang SC', sans-serif;
  color: var(--accent);
  opacity: 0.12;
  letter-spacing: 16rpx;
  pointer-events: none;
  z-index: -1;
}

.cc-light {
  color: #0f1419 !important;
  opacity: 0.15;
}

/* ── 底部 ── */
.footer {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding: 60rpx 0 40rpx;
}
.footer text {
  font-size: 22rpx;
  color: var(--text-dim);
  letter-spacing: 6rpx;
  display: block;
  text-align: center;
}
/* ── 日/夜间切换按钮 ── */
.theme-toggle {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 200rpx;
  height: 76rpx;
  border-radius: 76rpx;
  z-index: 500;
  --dark: 0;
  /* 日间天蓝 #5a81b4 → 夜间深蓝 #2b303e */
  background: hsl(204, calc(53% - var(--dark) * 28%), calc(47% - var(--dark) * 31%));
  /* 三层光圈：上高光 / 下阴影 / 柔光散播 */
  box-shadow:
    0 4rpx 1rpx -2rpx rgba(255,255,255,0.95),
    0 -4rpx 1rpx -2rpx rgba(0,0,0,0.2),
    0 4rpx 40rpx 0 rgba(255,255,255,0.15);
  transition: background 0.5s cubic-bezier(0.4,-0.3,0.6,1.3);
  overflow: hidden;
}

.theme-toggle.is-light {
  --dark: 1;
  box-shadow:
    0 4rpx 1rpx -2rpx rgba(255,255,255,0.5),
    0 -4rpx 1rpx -2rpx rgba(0,0,0,0.1),
    0 4rpx 40rpx 0 rgba(0,0,0,0.08);
}

/* 内凹边框 — 上方暗槽 + 下方深槽（在光圈后面） */
.theme-toggle::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 76rpx;
  z-index: 1;
  pointer-events: none;
  box-shadow:
    0 -5rpx 5rpx 0 rgba(0,0,0,0.15) inset,
    0 5rpx 5rpx 0 rgba(0,0,0,0.65) inset;
}

/* 太阳/月亮圈（容器 + 滑动） */
.toggle-circle {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  transition: transform 0.5s cubic-bezier(0.4,-0.3,0.6,1.3);
  z-index: 5;
}

.theme-toggle.is-light .toggle-circle {
  transform: translateX(124rpx);
}

/* 三层同心光圈（原版 radial-gradient 方式） */
.toggle-circle::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 300%;
  height: 300%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  z-index: -1;
  background:
    radial-gradient(circle, rgba(255,255,255,0.25) 28%, transparent 30%),
    radial-gradient(circle, rgba(255,255,255,0.25) 48%, transparent 50%),
    radial-gradient(circle, rgba(255,255,255,0.25) 68%, transparent 70%);
  transition: transform 0.5s cubic-bezier(0.4,-0.3,0.6,1.3);
}

/* 太阳本体 — 金色球形，仅内阴影不发光（光圈由 ::before 画） */
.toggle-sun {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  background: hsl(47, 91%, 58%);
  overflow: hidden;
  box-shadow:
    3rpx 3rpx 5rpx 0 rgba(255,255,255,0.9) inset,
    -3rpx -3rpx 5rpx 0 rgba(0,0,0,0.35) inset;
}

/* 月亮本体 — 比太阳大一点点以便完全覆盖，仅内阴影 */
.toggle-moon {
  position: absolute;
  top: -1%; left: -1%; right: -1%; bottom: -1%;
  border-radius: 50%;
  background: hsl(212, 13%, 82%);
  transition: transform 0.5s ease-in-out;
  transform: translateX(105%);
  box-shadow:
    3rpx 3rpx 5rpx 0 rgba(255,255,255,0.85) inset,
    -3rpx -3rpx 5rpx 0 rgba(0,0,0,0.5) inset;
}

.theme-toggle.is-light .toggle-moon {
  transform: translateX(0);
}

/* 陨石坑 */
.moon-crater {
  position: absolute;
  background: hsl(221, 16%, 68%);
  border-radius: 50%;
  box-shadow:
    0.5rpx 0.5rpx 1.5rpx 0 rgba(0,0,0,0.2) inset,
    0 0.5rpx 1.5rpx 0 rgba(255,255,255,0.25);
}

.moon-crater:nth-child(1) { width: 10rpx; height: 10rpx; left: 38%; top: 14%; }
.moon-crater:nth-child(2) { width: 12rpx; height: 12rpx; left: 58%; top: 54%; }
.moon-crater:nth-child(3) { width: 18rpx; height: 18rpx; left: 18%; top: 36%; }

/* 云朵 — 底部云层，夜间滑出（原版 translate 动画） */
.toggle-clouds {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: transform 0.5s cubic-bezier(0.4,-0.3,0.6,1.3);
  transform: translateY(calc(var(--dark) * 100%));
  pointer-events: none;
  z-index: 2;
}

/* 云层 1：底层大圆 */
.toggle-clouds::before {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 10rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.92);
  box-shadow:
    /* 左半部压低 */
    26rpx 24rpx 0 14rpx rgba(255,255,255,0.88),
    56rpx 20rpx 0 20rpx rgba(255,255,255,0.85),
    90rpx 12rpx 0 16rpx rgba(255,255,255,0.9),
    /* 右半部保持 */
    120rpx -6rpx 0 12rpx rgba(255,255,255,0.83),
    150rpx -10rpx 0 18rpx rgba(255,255,255,0.8),
    180rpx -30rpx 0 10rpx rgba(255,255,255,0.85);
}

/* 云层 2：上层小圆 */
.toggle-clouds::after {
  content: '';
  position: absolute;
  bottom: 14rpx;
  left: 24rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.8);
  box-shadow:
    /* 左半部压低 */
    30rpx 16rpx 0 8rpx rgba(255,255,255,0.75),
    64rpx 12rpx 0 12rpx rgba(255,255,255,0.7),
    /* 右半部保持 */
    100rpx -8rpx 0 6rpx rgba(255,255,255,0.72),
    136rpx -10rpx 0 10rpx rgba(255,255,255,0.68),
    168rpx -24rpx 0 7rpx rgba(255,255,255,0.65);
}

/* 星星层 */
.toggle-stars {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  transition: opacity 0.5s ease;
  opacity: var(--dark);
  pointer-events: none;
  z-index: 1;
}

.stars-dot {
  position: absolute;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: #fff;
  animation: star-twinkle 6s ease-in-out infinite;
}

@keyframes star-twinkle {
  0%, 40%, 60%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(var(--peak, 2.5)); opacity: 0.8; }
}

/* ── 主题切换全屏过渡动画 ── */
.theme-transition {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 999;
  pointer-events: none;
}

.transit-ball {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-left: -50rpx;
  margin-top: -50rpx;
  transform-origin: 50% 900rpx;
  box-shadow:
    3rpx 3rpx 5rpx 0 rgba(255,255,255,0.9) inset,
    -3rpx -3rpx 5rpx 0 rgba(0,0,0,0.35) inset;
}

.transit-ball.is-sun {
  background:
    radial-gradient(circle at 40% 40%, rgba(255,255,255,0.7) 0%, transparent 40%),
    radial-gradient(circle at 50% 50%, hsl(50, 100%, 70%) 0%, hsl(47, 91%, 55%) 30%, hsl(35, 80%, 45%) 70%, transparent 72%),
    radial-gradient(circle at 50% 50%, hsl(47, 91%, 58%) 60%, transparent 62%);
  box-shadow:
    0 0 30rpx 10rpx rgba(233,203,80,0.5),
    3rpx 3rpx 5rpx 0 rgba(255,255,255,0.9) inset,
    -3rpx -3rpx 5rpx 0 rgba(0,0,0,0.25) inset;
}

.transit-ball.is-moon {
  background:
    radial-gradient(circle at 38% 38%, rgba(255,255,255,0.4) 0%, transparent 35%),
    radial-gradient(circle at 55% 60%, rgba(0,0,0,0.06) 0%, transparent 40%),
    radial-gradient(circle at 40% 22%, hsl(221, 16%, 65%) 0, hsl(221, 16%, 65%) 12rpx, transparent 13rpx),
    radial-gradient(circle at 62% 48%, hsl(221, 16%, 65%) 0, hsl(221, 16%, 65%) 9rpx, transparent 10rpx),
    radial-gradient(circle at 28% 52%, hsl(221, 16%, 65%) 0, hsl(221, 16%, 65%) 16rpx, transparent 17rpx),
    radial-gradient(circle at 50% 50%, hsl(215, 15%, 88%) 0%, hsl(215, 15%, 78%) 60%, hsl(215, 15%, 68%) 100%);
  box-shadow:
    0 0 20rpx 8rpx rgba(200,205,215,0.5),
    3rpx 3rpx 5rpx 0 rgba(255,255,255,0.85) inset,
    -3rpx -3rpx 5rpx 0 rgba(0,0,0,0.35) inset;
}

.theme-transition.active .transit-out {
  animation: transit-rise 1.9s linear forwards;
}

.theme-transition.active .transit-in {
  animation: transit-fall 1.9s linear forwards;
}

@keyframes transit-rise {
  0% {
    transform: rotate(-30deg);
    opacity: 0;
  }
  32% {
    transform: rotate(0deg);
    opacity: 1;
  }
  74% {
    transform: rotate(0deg);
    opacity: 1;
  }
  90% {
    transform: rotate(0deg);
    opacity: 0;
  }
  100% {
    transform: rotate(0deg);
    opacity: 0;
  }
}

@keyframes transit-fall {
  0% {
    transform: rotate(0deg);
    opacity: 1;
  }
  32% {
    transform: rotate(30deg);
    opacity: 0;
  }
  100% {
    transform: rotate(30deg);
    opacity: 0;
  }
}
