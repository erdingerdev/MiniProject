.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  position: relative;
  overflow: hidden;
  background: #080b11;
}

/* ── 背景光球 ── */
.bg-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
}
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.3;
}
.orb-cyan {
  width: 400rpx; height: 400rpx;
  top: 10%; left: -100rpx;
  background: rgba(6, 182, 212, 0.4);
  animation: float-cyan 8s ease-in-out infinite alternate;
}
.orb-purple {
  width: 360rpx; height: 360rpx;
  bottom: 20%; right: -80rpx;
  background: rgba(139, 92, 246, 0.3);
  animation: float-purple 10s ease-in-out infinite alternate;
}
@keyframes float-cyan {
  0% { transform: translate(0, 0); }
  100% { transform: translate(40rpx, -24rpx); }
}
@keyframes float-purple {
  0% { transform: translate(0, 0); }
  100% { transform: translate(-24rpx, 40rpx); }
}

/* ── 随机亮点 ── */
.dots-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
}
.dot {
  position: absolute;
  border-radius: 50%;
  background: #22d3ee;
  animation: twinkle 3s ease-in-out infinite alternate;
}
@keyframes twinkle {
  0% { transform: scale(0.4); opacity: 0.15; }
  100% { transform: scale(1.2); opacity: 0.6; }
}

/* ── 用户栏 ── */
.user-bar {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  width: 100%;
  margin-top: 80rpx;
}
.user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.user-avatar.placeholder {
  background: rgba(255,255,255,0.08);
}
.user-info {
  display: flex;
  flex-direction: column;
}
.user-name {
  font-size: 26rpx;
  color: #a1a1aa;
}
.status-row {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 8rpx;
  position: relative;
}
.status-dot::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: inherit;
  opacity: 0.4;
  animation: pulse-glow 2s ease-in-out infinite;
}
@keyframes pulse-glow {
  0%, 100% { transform: scale(0.6); opacity: 0.15; }
  50% { transform: scale(1.6); opacity: 0.4; }
}
.passcode-status {
  font-size: 22rpx;
  color: #a1a1aa;
}
.inactive-reminder {
  font-size: 22rpx;
  color: #fbbf24;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ── 标题 ── */
.hero {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
  text-align: center;
}
.hero-title {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #22d3ee, #60a5fa, #a78bfa, #22d3ee);
  background-size: 300% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 24rpx;
  animation: marquee 3s linear infinite;
  filter: drop-shadow(0 0 32rpx rgba(34, 211, 238, 0.25));
}
@keyframes marquee {
  0% { background-position: 150% 0; }
  100% { background-position: -150% 0; }
}
.hero-sub {
  font-size: 26rpx;
  color: #71717a;
  letter-spacing: 4rpx;
}

/* ── 入口宫格 ── */
.grid {
  position: relative;
  z-index: 1;
  margin-top: 80rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
  width: 100%;
}
.card {
  flex: 1 1 280rpx;
  min-width: 260rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all 0.2s;
  opacity: 0;
  transform: translateY(40rpx);
  animation: card-in 0.6s ease-out forwards;
}
@keyframes card-in {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.card:active {
  background: rgba(6,182,212,0.1);
  border-color: rgba(6,182,212,0.3);
  transform: scale(0.96) !important;
}
/* ── 卡片行 ── */
.card-row {
  display: flex;
  gap: 32rpx;
  width: 100%;
  opacity: 0;
  animation: card-in 0.6s ease-out forwards;
}
.card-half {
  flex: 1;
  min-width: 0;
  animation: none;
  opacity: 1;
  transform: none;
}

.card-icon { font-size: 56rpx; margin-bottom: 24rpx; }
.card-title { font-size: 32rpx; font-weight: 600; color: #e4e4e7; margin-bottom: 12rpx; }
.card-desc { font-size: 24rpx; color: #71717a; }

/* ── 底部 ── */
.footer {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding: 60rpx 0 40rpx;
}
.footer text {
  font-size: 22rpx;
  color: #3f3f46;
  letter-spacing: 6rpx;
}
