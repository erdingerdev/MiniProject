.container {
  min-height: 100vh;
  background: var(--bg-gradient, var(--bg));
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

/* ── 中心布局 ── */
.center-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 600rpx;
  padding-top: 80rpx;
}

.icon-lg { font-size: 96rpx; margin-bottom: 32rpx; }
.title { font-size: 40rpx; font-weight: 700; color: var(--text); margin-bottom: 16rpx; }
.pool-highlight { color: #fbbf24; }
.hint { font-size: 26rpx; color: var(--text-dim); margin-bottom: 40rpx; text-align: center; line-height: 1.6; }

/* ── 按钮 ── */
.btn-primary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--accent), #3b82f6);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-top: 16rpx;
}
.btn-primary[disabled] {
  opacity: 0.4;
}
.btn-save {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-bg);
  color: var(--accent);
  border-radius: 16rpx;
  font-size: 26rpx;
  border: 1rpx solid var(--accent-border);
  margin-bottom: 40rpx;
}
.hint-pay {
  margin-top: 24rpx;
  margin-bottom: 0;
  font-size: 28rpx;
  color: var(--text-dim);
}
.btn-secondary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-input);
  color: var(--text-dim);
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--border2);
  margin-top: 32rpx;
}

/* ── 输入框 ── */
.input-code {
  width: 100%;
  height: 88rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border2);
  border-radius: 16rpx;
  color: var(--text);
  font-size: 30rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}

.error-msg { color: #f87171; font-size: 26rpx; margin-top: 16rpx; }

/* ── 头像选择 ── */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.avatar-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(255,255,255,0.2);
  overflow: hidden;
}
.avatar-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
}
.avatar-empty {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--bg-card2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-plus {
  font-size: 48rpx;
  color: rgba(255,255,255,0.25);
  line-height: 1;
}
.avatar-picker {
  position: absolute;
  top: 0;
  left: 0;
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  opacity: 0.01;
}
.avatar-picker::after { border: none; }
.avatar-hint {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-top: 20rpx;
  text-align: center;
}

/* ── 昵称区域 ── */
.field-group {
  width: 100%;
  margin-bottom: 16rpx;
}
.field-label {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-bottom: 12rpx;
  display: block;
}
.nickname-input {
  text-align: center;
}
.field-tip {
  font-size: 22rpx;
  color: #f87171;
  margin-top: 12rpx;
  display: block;
  text-align: center;
}
.btn-skip {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--text-dim2);
  font-size: 26rpx;
  border: none;
  margin-top: 12rpx;
}
.btn-skip::after { border: none; }

/* ── 引导文案 ── */
.guide {
  font-size: 34rpx;
  font-weight: 700;
  color: #fbbf24;
  text-align: center;
  margin-bottom: 8rpx;
  line-height: 1.6;
  display: block;
}
.guide.green { color: #34d399; }

/* ── 收款码 ── */
.qr-img {
  width: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid var(--border2);
}
.qr-placeholder {
  width: 400rpx;
  height: 400rpx;
  background: var(--bg-card2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-dim2);
  font-size: 26rpx;
  margin-bottom: 32rpx;
}

/* ── 账号密码卡片 ── */
.cred-box {
  width: 100%;
  background: rgba(6,182,212,0.06);
  border: 1rpx solid var(--accent-border);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 8rpx;
}
.cred-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--bg-input);
}
.cred-row:last-child { border-bottom: none; }
.cred-label { font-size: 28rpx; color: var(--text-dim); }
.cred-value { font-size: 32rpx; color: var(--accent); font-weight: 600; font-family: monospace; }

/* ── 加载动画 ── */
.spinner {
  width: 64rpx; height: 64rpx;
  border: 4rpx solid var(--border2);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 32rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ── 人数选择 ── */
.count-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 32rpx;
}
.count-chip {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  color: var(--text-dim);
  font-size: 30rpx;
  font-weight: 600;
}
.count-chip.active {
  background: var(--accent-bg);
  border-color: var(--accent-border);
  color: var(--accent);
}
.price-box {
  width: 100%;
  background: rgba(34,211,238,0.06);
  border: 1rpx solid var(--accent-bg);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.price-label {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-bottom: 8rpx;
}
.price-total {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--accent);
}

/* ── 切换泳池浮动按钮 ── */
.switch-pool-btn {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--accent-border);
  border: 1rpx solid var(--accent-border);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.switch-icon {
  font-size: 36rpx;
  color: var(--accent);
}

.theme-light .switch-icon {
  color: rgba(255,255,255,0.9);
}

/* ── 绑定其他通行码按钮(左下) ── */
.bind-pool-btn {
  position: fixed;
  left: 40rpx;
  bottom: 200rpx;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: var(--accent-bg);
  border: 1rpx solid var(--accent-border);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.bind-icon-text {
  font-size: 26rpx;
  color: var(--accent);
}

.theme-light .bind-icon-text {
  color: rgba(255,255,255,0.9);
}

/* ── 居中弹窗 ── */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--overlay);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-card {
  width: 580rpx;
  background: var(--modal-bg);
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  animation: modalIn 0.25s ease;
}
@keyframes modalIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  display: block;
  margin-bottom: 32rpx;
}

/* ── 底部弹窗 ── */
.sheet-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--overlay);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.sheet-card {
  width: 100%;
  max-height: 70vh;
  background: var(--modal-bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 36rpx 60rpx;
  overflow-y: auto;
  animation: sheetUp 0.3s ease;
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  display: block;
  margin-bottom: 32rpx;
}

/* ── 泳池列表项 ── */
.pool-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
  background: var(--bg-card2);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}
.pool-item.active {
  background: var(--accent-bg);
  border-color: var(--accent-border);
}
.pool-item.invalid {
  opacity: 0.5;
}
.pool-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.pool-name {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 600;
}
.pool-price {
  font-size: 24rpx;
  color: var(--accent);
}
.pool-badge-invalid {
  font-size: 22rpx;
  color: #f87171;
  background: var(--danger-bg);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
  align-self: flex-start;
}
.pool-check {
  font-size: 40rpx;
  color: var(--accent);
  font-weight: 700;
}
.btn-sheet-close {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-input);
  color: var(--text-dim);
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--border2);
  margin-top: 24rpx;
}

/* ── 浅色模式渐变背景适配 ── */
.theme-light .hint { color: rgba(255,255,255,0.75); }
.theme-light .count-chip { color: rgba(255,255,255,0.8); }
.theme-light .price-label { color: rgba(255,255,255,0.7); }
.theme-light .field-label { color: rgba(255,255,255,0.75); }
.theme-light .avatar-hint { color: rgba(255,255,255,0.7); }
.theme-light .cred-label { color: rgba(255,255,255,0.75); }

.contact-link {
  font-size: 26rpx;
  color: var(--accent);
  text-decoration: underline;
  margin-top: 24rpx;
}
.theme-light .contact-link {
  color: rgba(255,255,255,0.8);
}
