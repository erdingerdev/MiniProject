<view class="container theme-{{theme}}">
  <view class="bg-layer">
    <view class="orb orb-cyan"></view>
    <view class="orb orb-purple"></view>
  </view>

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
  </view>

  <view class="hero">
    <text class="hero-title">驿站</text>
    <text class="hero-sub">更多功能 · 持续上新</text>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goCarpool">
      <view class="menu-left">
        <view class="menu-icon">🤝</view>
        <view class="menu-info">
          <text class="menu-title">结伴通勤</text>
          <text class="menu-desc">通勤路上 · 不再无聊</text>
        </view>
      </view>
      <view class="menu-right">
        <view class="menu-badge" wx:if="{{carpoolUnread}}">{{carpoolUnread > 99 ? '99+' : carpoolUnread}}</view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-item" bindtap="goFeedback">
      <view class="menu-left">
        <view class="menu-icon">💬</view>
        <view class="menu-info">
          <text class="menu-title">意见反馈</text>
          <text class="menu-desc">建议 · 吐槽 · 报 Bug</text>
        </view>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>
