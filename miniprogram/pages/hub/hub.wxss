.container {
  min-height: 100vh;
  padding: 0 40rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background: var(--bg-gradient, var(--bg));
}

.theme-dark { color: #e0e0e0; }
.theme-light { color: #2c2c2c; }
.container.theme-light { background: linear-gradient(160deg, #016B61 0%, #70B2B2 40%, #9ECFD4 70%, #E5E9C5 100%); }

.bg-layer { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.orb { position: absolute; border-radius: 50%; filter: blur(80rpx); opacity: 0.12; }
.orb-cyan { width: 400rpx; height: 400rpx; background: #06b6d4; top: -100rpx; right: -100rpx; }
.orb-purple { width: 300rpx; height: 300rpx; background: #8b5cf6; bottom: -80rpx; left: -80rpx; }

/* ── 自定义导航栏 ── */
.nav-bar {
  position: relative; z-index: 10;
  display: flex; align-items: center; justify-content: center;
  height: 88rpx;
}
.nav-back {
  position: absolute; left: -20rpx; bottom: 0;
  width: 64rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
}
.nav-back-icon { font-size: 52rpx; color: #e0e0e0; line-height: 1; }
.theme-light .nav-back-icon { color: #fff; }
.theme-light .hero-title { color: #fff; }
.theme-light .hero-sub { color: rgba(255,255,255,0.8); }
.theme-light .menu-title { color: #0a2a26; }
.theme-light .menu-desc { color: #3a6a64; }

/* ── 页面标题 ── */
.hero {
  position: relative; z-index: 1;
  text-align: center; padding: 16rpx 0 32rpx;
}
.hero-title {
  font-size: 48rpx; font-weight: 700; letter-spacing: 12rpx;
  display: block; color: #e0e0e0;
}
.theme-light .hero-title { color: #fff; }
.hero-sub {
  font-size: 24rpx; opacity: 0.45; margin-top: 12rpx; display: block; color: #e0e0e0;
}
.theme-light .hero-sub { color: rgba(255,255,255,0.8); }

/* ── 菜单 ── */
.menu-list {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; gap: 24rpx;
}

.menu-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: var(--bg-card2);
  border: 1rpx solid var(--border);
}
.theme-light .menu-item { background: rgba(255,255,255,0.45); }

.menu-left { display: flex; align-items: center; gap: 24rpx; }
.menu-icon { font-size: 40rpx; }
.menu-info { display: flex; flex-direction: column; gap: 6rpx; }
.menu-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.menu-desc { font-size: 22rpx; color: var(--text-dim); }

.menu-right { display: flex; align-items: center; gap: 16rpx; }
.menu-badge {
  min-width: 36rpx; height: 36rpx; line-height: 36rpx;
  text-align: center; font-size: 20rpx; font-weight: 700;
  color: #fff; background: #ef4444; border-radius: 18rpx;
  padding: 0 8rpx;
}
.menu-arrow { font-size: 36rpx; opacity: 0.25; }
