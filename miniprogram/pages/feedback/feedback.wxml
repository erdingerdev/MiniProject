<view class="container theme-{{theme}}">
  <view class="form">
    <text class="label">说说你想要什么功能</text>
    <textarea class="textarea" placeholder="比如：想要每周排行榜、泳姿教学视频..." value="{{content}}" bindinput="onInput" maxlength="500"/>
    <text class="count">{{content.length}}/500</text>
    <button class="btn-submit {{content.length > 0 ? 'active' : ''}}" bindtap="doSubmit" disabled="{{content.length === 0}}">提交反馈</button>
  </view>
</view>
