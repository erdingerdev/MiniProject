<view class="container theme-{{theme}}">
  <!-- 背景光球 -->
  <view class="bg-layer">
    <view class="orb orb-cyan"></view>
    <view class="orb orb-purple"></view>
  </view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack"><text class="nav-back-icon">‹</text></view>
    <text class="nav-title">通勤公告栏</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 我的路线 -->
  <view class="my-section" wx:if="{{myRoute}}">
    <view class="my-header">
      <view class="my-badge {{myRoute.type === 'driver' ? 'badge-driver' : 'badge-passenger'}}">{{myRoute.type === 'driver' ? '找人' : '找车'}}</view>
      <view class="my-status {{myRoute.status}}">{{myRoute.status === 'pending' ? '审核中' : myRoute.status === 'approved' ? '已通过' : '已拒绝'}}</view>
    </view>
    <view class="my-reject-reason" wx:if="{{myRoute.status === 'rejected' && myRoute.rejectReason}}">拒绝原因：{{myRoute.rejectReason}}</view>

    <view class="my-route-line">{{myRoute.origin}}  →  {{myRoute.destination}}</view>

    <view class="my-meta">
      <text class="my-meta-item">出发时间 {{myRoute.departTime}}</text>
      <text class="my-meta-item">{{myRoute.type === 'driver' ? '可乘人数' : '通勤人数'}} {{myRoute.peopleCount}}人</text>
    </view>
    <view class="my-meta my-contact">
      <text class="my-meta-item">联系方式 {{myRoute.contact}}</text>
    </view>

    <view class="my-note" wx:if="{{myRoute.note}}">
      <text class="my-note-text">备注 {{myRoute.note}}</text>
    </view>

    <view class="my-remind" wx:if="{{myRoute.status === 'pending'}}">
      <button class="remind-btn" bindtap="remindReview" disabled="{{reviewReminded}}">{{reviewReminded ? '已提醒' : '提醒审核'}}</button>
    </view>

    <!-- 车主：乘客列表 -->
    <view class="my-passengers" wx:if="{{myRoute.type === 'driver' && myInteractions.length > 0}}">
      <text class="section-label">加入列表</text>
      <view class="passenger-item" wx:for="{{myInteractions}}" wx:key="_id" wx:if="{{item.type === 'join'}}">
        <text class="passenger-name">{{item.interactorNickname}}</text>
        <text class="passenger-remove" bindtap="kickPassenger" data-id="{{item._id}}">移除</text>
      </view>
    </view>

    <!-- 乘客：邀请列表 -->
    <view class="my-passengers" wx:if="{{myRoute.type === 'passenger' && myInteractions.length > 0}}">
      <text class="section-label">司机邀请</text>
      <view class="passenger-item invite-item" wx:for="{{myInteractions}}" wx:key="_id" wx:if="{{item.type === 'invite'}}" bindtap="showRouteContact" data-item="{{item}}">
        <text class="passenger-name">{{item.interactorNickname}}</text>
        <text class="passenger-arrow">›</text>
      </view>
    </view>

    <view class="my-actions">
      <button class="my-delete-btn" bindtap="deleteMyRoute">删除发布</button>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="divider" wx:if="{{myRoute}}">
    <view class="divider-line"></view>
    <text class="divider-text">全部路线</text>
    <view class="divider-line"></view>
  </view>

  <!-- 路线列表 -->
  <view class="route-list">
    <view class="route-item" wx:for="{{routes}}" wx:key="_id" wx:if="{{!myRoute || item._id !== myRoute._id}}" bindtap="showRouteDetail" data-route="{{item}}">
      <view class="route-left">
        <view class="route-type {{item.type === 'driver' ? 'badge-driver' : 'badge-passenger'}}">{{item.type === 'driver' ? '找人' : '找车'}}</view>
        <view class="route-info">
          <text class="route-line">{{item.origin}} → {{item.destination}}</text>
          <text class="route-sub">出发 {{item.departTime}} · {{item.peopleCount}}人</text>
        </view>
      </view>
      <view class="route-right">
        <text class="route-nickname">{{item.nickname}}</text>
        <text class="route-arrow">›</text>
      </view>
    </view>

    <view class="empty" wx:if="{{routes.length === 0 && !myRoute}}">
      <text class="empty-text">暂无路线，发布第一条吧</text>
    </view>

    <text class="load-more" wx:if="{{!noMore}}" bindtap="loadMore">加载更多</text>
  </view>

  <!-- 详情弹窗 -->
  <view class="modal-overlay" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="modal-card" catchtap="noop">
      <view class="modal-close" bindtap="closeDetail">✕</view>

      <block wx:if="{{detailRoute}}">
        <view class="modal-route-type {{detailRoute.type === 'driver' ? 'badge-driver' : 'badge-passenger'}}">{{detailRoute.type === 'driver' ? '找人' : '找车'}}</view>
        <text class="modal-route">{{detailRoute.origin}} → {{detailRoute.destination}}</text>
        <view class="modal-fields">
          <text class="modal-field">出发时间：{{detailRoute.departTime}}</text>
          <text class="modal-field">人数：{{detailRoute.peopleCount}}人</text>
          <text class="modal-field" wx:if="{{detailRoute.note}}">备注：{{detailRoute.note}}</text>
        </view>

        <view class="modal-contact" wx:if="{{showContact}}">
          <view wx:if="{{inviteSent}}" bindtap="cancelInvite">
            <text class="invite-sent-text">已将您的邀请发送给对方</text>
            <text class="invite-cancel-hint">点击取消邀请</text>
          </view>
          <block wx:else>
            <text class="contact-label">联系方式</text>
            <view class="contact-row">
              <text class="contact-value">{{contactText}}</text>
              <text class="contact-copy" bindtap="copyContact">📋 复制</text>
            </view>
            <text class="cancel-join" bindtap="cancelJoin" wx:if="{{!inviteSent}}">情况有变，取消加入</text>
          </block>
        </view>

        <button class="modal-btn" wx:if="{{!showContact}}" bindtap="doInteract">
          {{detailRoute.type === 'driver' ? '我想加入' : '我想邀请'}}
        </button>
        <text class="modal-hint" wx:if="{{!showContact}}">
          {{detailRoute.type === 'driver' ? '确认后可查看联系方式' : '确认后对方可查看你的联系方式'}}
        </text>
      </block>

      <block wx:else>
        <view class="modal-contact">
          <text class="contact-label">联系方式</text>
          <view class="contact-row">
            <text class="contact-value">{{contactText}}</text>
            <text class="contact-copy" bindtap="copyContact">📋 复制</text>
          </view>
          <text class="cancel-join" bindtap="cancelJoin">取消此邀请</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="footer-note">
    <text>本平台仅提供路线信息展示，请自行注意安全，双方自行联系并承担相应风险</text>
  </view>

  <!-- 发布悬浮按钮 -->
  <view class="fab" bindtap="goPublish">
    <text class="fab-icon">+</text>
  </view>
</view>
