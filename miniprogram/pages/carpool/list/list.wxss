.container { min-height: 100vh; box-sizing: border-box; background: var(--bg-gradient, var(--bg)); }
.container.theme-light { background: linear-gradient(160deg, #016B61 0%, #70B2B2 40%, #9ECFD4 70%, #E5E9C5 100%); }
.theme-light .modal-card { background: linear-gradient(135deg, rgba(163,97,50,0.65) 0%, rgba(198,141,92,0.35) 100%); backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx); border: 1rpx solid rgba(255,255,255,0.2); box-shadow: 0 0 40rpx rgba(163,97,50,0.2), 0 8rpx 32rpx rgba(0,0,0,0.15), inset 0 1rpx 0 rgba(255,255,255,0.1); border-radius: 24rpx; }
.theme-light .modal-route { color: #fff; font-weight: 700; text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.1); }
.theme-light .modal-field { color: rgba(255,255,255,0.9); font-size: 28rpx; }
.theme-light .contact-label { color: rgba(255,255,255,0.6); }
.theme-light .contact-value { color: #fff; }
.theme-light .modal-hint { color: rgba(255,255,255,0.65); }
.theme-light .invite-sent-text { color: #fff; }
.theme-light .invite-cancel-hint { color: #ffb3b3; }
.theme-light .modal-close { color: rgba(255,255,255,0.6); }
.theme-light .cancel-join { color: #ef4444; font-weight: 600; text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.2); }
.theme-light .route-item { background: rgba(255,255,255,0.72); }
.theme-light .my-section { background: rgba(255,255,255,0.55); }

/* 背景光球 */
.bg-layer { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.orb { position: absolute; border-radius: 50%; filter: blur(80rpx); opacity: 0.12; }
.orb-cyan { width: 400rpx; height: 400rpx; background: #06b6d4; top: -100rpx; right: -100rpx; }
.orb-purple { width: 300rpx; height: 300rpx; background: #8b5cf6; bottom: -80rpx; left: -80rpx; }

/* 导航栏 - 固定 */
.nav-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding-left: 40rpx; padding-right: 40rpx; padding-bottom: 16rpx; box-sizing: border-box; background: rgba(0,0,0,0.3); backdrop-filter: blur(10rpx); }
.theme-light .nav-bar { background: rgba(1,107,97,0.5); backdrop-filter: blur(10rpx); }
.nav-back { width: 64rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.nav-back-icon { font-size: 52rpx; color: #e0e0e0; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #e0e0e0; }
.nav-placeholder { width: 64rpx; }

/* 悬浮按钮 */
.fab { position: fixed; right: 40rpx; bottom: 120rpx; width: 96rpx; height: 96rpx; border-radius: 48rpx; background: #34d399; display: flex; align-items: center; justify-content: center; z-index: 50; box-shadow: 0 8rpx 24rpx rgba(52,211,153,0.3); }
.fab-icon { font-size: 48rpx; color: #1a1a1a; font-weight: 300; line-height: 1; }

/* 我的区域 */
.my-section { position: relative; z-index: 1; background: rgba(255,255,255,0.04); border-radius: 16rpx; padding: 28rpx 24rpx 24rpx; margin: 0 40rpx 24rpx; border: 1rpx solid rgba(255,255,255,0.06); }
.my-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.my-reject-reason { font-size: 24rpx; color: #f87171; margin-bottom: 12rpx; }
.my-route-line { text-align: left; margin: 16rpx 0 16rpx; }
.my-route-line .route-stop { font-size: 28rpx; font-weight: 600; color: #e0e0e0; margin-bottom: 8rpx; }
.theme-light .my-route-line .route-stop { color: #0a2a26; }
.my-meta { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 8rpx; }
.my-contact { margin-top: 4rpx; }
.my-meta-item { font-size: 28rpx; color: #ccc; }
.my-note { margin-top: 10rpx; margin-bottom: 10rpx; }
.my-note-text { font-size: 26rpx; color: #aaa; }
.my-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.my-status.pending { background: #fbbf24; color: #1a1a1a; }
.my-status.approved { background: #34d399; color: #1a1a1a; }
.my-status.rejected { background: #f87171; color: #fff; }
.my-status.expired { background: rgba(148,163,184,0.2); color: #94a3b8; }
.my-expired { opacity: 0.55; }
.my-expired .my-route-line .route-stop,
.my-expired .my-meta-item,
.my-expired .my-contact,
.my-expired .my-note-text { color: #666 !important; }
.my-expired .my-badge { opacity: 0.4; }
.my-passengers { background: rgba(255,255,255,0.03); border-radius: 12rpx; padding: 16rpx 20rpx; margin-top: 16rpx; }
.section-label { font-size: 24rpx; color: #888; display: block; margin-bottom: 12rpx; }
.passenger-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.passenger-name { font-size: 26rpx; color: #ccc; }
.passenger-remove { font-size: 22rpx; color: #f87171; }
.passenger-arrow { font-size: 28rpx; color: #888; }
.invite-item { background: rgba(6,182,212,0.08); border-radius: 10rpx; padding: 16rpx 20rpx !important; margin-bottom: 8rpx; cursor: pointer; }
.my-remind { margin-top: 16rpx; text-align: center; }
.remind-btn { background: rgba(251,191,36,0.15); border: 2rpx solid rgba(251,191,36,0.3); color: #fbbf24; font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 10rpx; display: inline-block; }
.remind-btn[disabled] { opacity: 0.4; border-color: rgba(255,255,255,0.1); color: #888; background: rgba(255,255,255,0.04); }
.theme-light .remind-btn { background: rgba(251,191,36,0.2); border-color: rgba(251,191,36,0.4); color: #a06800; }
.theme-light .remind-btn[disabled] { background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.08); color: #999; }
.my-actions { margin-top: 16rpx; display: flex; justify-content: center; }
.my-delete-btn { background: rgba(248,113,113,0.1); border: 1rpx solid rgba(248,113,113,0.2); color: #f87171; font-size: 24rpx; padding: 10rpx 48rpx; border-radius: 10rpx; }

/* 徽章 */
.badge-driver { font-size: 28rpx; font-weight: 700; padding: 8rpx 18rpx; border-radius: 8rpx; background: rgba(6,182,212,0.2); color: #06b6d4; }
.badge-passenger { font-size: 28rpx; font-weight: 700; padding: 8rpx 18rpx; border-radius: 8rpx; background: rgba(251,191,36,0.2); color: #fbbf24; }
.badge-self { display: inline-block; font-size: 28rpx; font-weight: 700; padding: 8rpx 18rpx; border-radius: 8rpx; background: rgba(148,163,184,0.2); color: #94a3b8; margin-left: 12rpx; }
.theme-light .badge-self { background: rgba(148,163,184,0.65); color: #fff; font-weight: 700; }

/* 分割线 */
.divider { position: relative; z-index: 1; display: flex; align-items: center; gap: 16rpx; margin: 0 40rpx 24rpx; }
.divider-line { flex: 1; height: 1rpx; background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,0.12), rgba(255,255,255,0)); }
.divider-text { font-size: 22rpx; color: #555; flex-shrink: 0; }

/* 列表 */
.route-list { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 16rpx; }
.route-item { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 20rpx; border-radius: 14rpx; background: rgba(255,255,255,0.04); }
.route-left { display: flex; align-items: center; gap: 16rpx; flex: 1; overflow: hidden; }
.route-info { display: flex; flex-direction: column; gap: 6rpx; overflow: hidden; }
.route-line { display: flex; flex-direction: column; align-items: flex-start; gap: 2rpx; }
.route-stop { font-size: 26rpx; color: #ccc; }
.route-line .route-stop { font-weight: 500; }
.modal-route .route-stop { font-weight: 500; }
.theme-light .route-stop { color: #2a5a54; }
.route-sub { font-size: 26rpx; color: #aaa; }
.route-right { display: flex; align-items: center; gap: 8rpx; }
.route-nickname { font-size: 22rpx; color: #666; max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.route-arrow { font-size: 28rpx; color: #555; }
.route-item { margin: 0 40rpx 16rpx; }
.load-more { text-align: center; font-size: 24rpx; color: #888; height: 160rpx; margin: 0 40rpx; }
.empty { text-align: center; padding: 80rpx 0; }
.empty-text { font-size: 26rpx; color: #555; }

/* 页脚提示 */
.footer-note { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; height: 160rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 50%, transparent 100%); }
.theme-light .footer-note { background: linear-gradient(to top, rgba(255,255,255,1) 0%, rgba(255,255,255,1) 50%, transparent 100%); }
.footer-note text { font-size: 20rpx; color: #999; line-height: 1.5; }
.theme-light .footer-note text { color: rgba(0,0,0,0.5); }
.theme-light .route-line { color: #0a2a26; }
.theme-light .my-route-line { color: #0a2a26; }
.theme-light .my-meta-item { color: #1a4a44; }
.theme-light .my-note-text { color: #2a5a54; }
.theme-light .passenger-name { color: #1a4a44; }
.theme-light .nav-back-icon,
.theme-light .nav-title { color: #fff; }
.theme-light .nav-add { color: #fff; }
.theme-light .route-nickname { color: #3a6a64; }
.theme-light .route-sub { color: #2a5a54; }
.theme-light .my-passengers { background: rgba(0,0,0,0.03); }
.theme-light .section-label { color: #2a5a54; }
.theme-light .empty-text { color: #3a6a64; }
.theme-light .divider-text { color: #4a7a74; }
.theme-light .badge-driver { background: rgba(6,182,212,0.7); color: #fff; font-weight: 700; }
.theme-light .badge-passenger { background: rgba(251,191,36,0.75); color: #fff; font-weight: 700; }
.theme-light .my-status.pending { background: #e6a800; color: #fff; }
.theme-light .my-status.approved { background: #1a8a6a; color: #fff; }
.theme-light .my-status.expired { background: rgba(148,163,184,0.25); color: #64748b; }
.theme-light .my-expired .my-route-line .route-stop,
.theme-light .my-expired .my-meta-item,
.theme-light .my-expired .my-contact,
.theme-light .my-expired .my-note-text { color: #999 !important; }

/* 弹窗 */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 900; display: flex; align-items: center; justify-content: center; }
.modal-card { background: #1a1f2e; border-radius: 20rpx; padding: 40rpx 32rpx; width: 580rpx; position: relative; border: 1rpx solid rgba(255,255,255,0.08); box-shadow: 0 0 40rpx rgba(6,182,212,0.15), 0 8rpx 32rpx rgba(0,0,0,0.5), inset 0 1rpx 0 rgba(255,255,255,0.04); }
.modal-close { position: absolute; top: 16rpx; right: 20rpx; font-size: 32rpx; color: #888; }
.modal-route-type { display: inline-block; margin-bottom: 12rpx; }
.modal-route { margin: 16rpx 0 16rpx; text-align: left; }
.modal-route .route-stop { font-size: 28rpx; color: #ccc; display: block; margin-bottom: 8rpx; }
.theme-light .modal-route .route-stop { font-size: 28rpx; color: rgba(255,255,255,0.9); }
.modal-fields { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 24rpx; }
.modal-field { font-size: 28rpx; color: #ccc; font-weight: 500; }
.modal-contact { margin-bottom: 24rpx; }
.contact-label { font-size: 24rpx; color: #888; display: block; margin-bottom: 8rpx; }
.contact-row { display: flex; align-items: center; gap: 16rpx; background: rgba(255,255,255,0.06); border-radius: 10rpx; padding: 16rpx; }
.contact-value { font-size: 28rpx; color: #e0e0e0; flex: 1; }
.contact-copy { font-size: 24rpx; color: #34d399; }
.modal-btn { width: 100%; height: 80rpx; background: #34d399; color: #1a1a1a; font-size: 28rpx; font-weight: 600; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.modal-hint { font-size: 22rpx; color: #666; text-align: center; display: block; margin-top: 12rpx; }
.invite-sent-text { font-size: 28rpx; color: #34d399; text-align: center; display: block; padding: 16rpx 0 6rpx; }
.invite-cancel-hint { font-size: 22rpx; color: #f87171; text-align: center; display: block; padding-bottom: 12rpx; }
.cancel-join { font-size: 24rpx; color: #f87171; text-align: center; display: block; margin-top: 20rpx; }

