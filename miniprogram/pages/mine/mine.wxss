.container {
  min-height: 100vh;
  background: var(--bg-gradient, var(--bg));
  padding: 0 36rpx 36rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.container.theme-light { background: linear-gradient(160deg, #016B61 0%, #70B2B2 40%, #9ECFD4 70%, #E5E9C5 100%); }

/* 背景光球 */
.bg-layer { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.orb { position: absolute; border-radius: 50%; filter: blur(80rpx); opacity: 0.12; }
.orb-cyan { width: 400rpx; height: 400rpx; background: #06b6d4; top: -100rpx; right: -100rpx; }
.orb-purple { width: 300rpx; height: 300rpx; background: #8b5cf6; bottom: -80rpx; left: -80rpx; }

/* 自定义导航栏 */
.nav-bar { position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; width: 100%; height: 88rpx; margin-bottom: 20rpx; }
.nav-back { width: 64rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.nav-back-icon { font-size: 52rpx; color: #e0e0e0; }
.theme-light .nav-back-icon { color: #fff; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #e0e0e0; }
.theme-light .nav-title { color: #fff; }
.nav-placeholder { width: 64rpx; }

/* ── Milestone popup ── */
.milestone-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(4,8,20,0.85);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.milestone-card {
  position: relative;
  width: 520rpx;
  background: linear-gradient(145deg, var(--border), rgba(255,255,255,0.02));
  border: 1rpx solid rgba(251,191,36,0.3);
  border-radius: 32rpx;
  padding: 56rpx 40rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 0 80rpx rgba(251,191,36,0.15), 0 0 200rpx rgba(34,211,238,0.08), inset 0 1rpx 0 var(--border);
  animation: milestoneIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes milestoneIn {
  0% { transform: scale(0.4); opacity: 0; }
  60% { transform: scale(1.05); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* 光点 */
.milestone-spark {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fbbf24;
  animation: sparkPulse 1.5s ease-in-out infinite;
}
.milestone-spark.left-top {
  top: 28rpx; left: 28rpx;
  animation-delay: 0s;
}
.milestone-spark.right-bottom {
  bottom: 28rpx; right: 28rpx;
  animation-delay: 0.75s;
}
@keyframes sparkPulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(2); opacity: 1; }
}

/* 徽章圆圈 */
.milestone-badge {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.badge-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(from 0deg, #fbbf24, #f59e0b, #d97706, #fbbf24, var(--accent), var(--accent), #fbbf24);
  animation: ringSpin 3s linear infinite;
}
@keyframes ringSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.milestone-badge::after {
  content: '';
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(8,11,17,0.9);
  z-index: 1;
}
.milestone-emoji {
  font-size: 72rpx;
  z-index: 2;
  filter: drop-shadow(0 0 12rpx rgba(251,191,36,0.5));
}

/* 分割线 */
.milestone-divider {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(251,191,36,0.5), transparent);
  margin-bottom: 24rpx;
}

.milestone-count {
  font-size: 72rpx;
  font-weight: 900;
  background: linear-gradient(180deg, #fde68a 0%, #fbbf24 40%, #f59e0b 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1;
}

.milestone-label {
  font-size: 26rpx;
  color: rgba(251,191,36,0.7);
  font-weight: 600;
  letter-spacing: 8rpx;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.milestone-text {
  font-size: 28rpx;
  color: #d4d4d8;
  text-align: center;
  line-height: 1.6;
}
.summary-text {
  font-size: 34rpx;
  margin-top: 28rpx;
  color: var(--text);
  line-height: 1.8;
}

/* ── Month bar ── */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 32rpx;
  gap: 48rpx;
}
.month-arrow {
  font-size: 36rpx;
  color: var(--text-dim);
  padding: 12rpx 24rpx;
}
.month-label {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  min-width: 240rpx;
  text-align: center;
}

/* ── Slide animation ── */
.slide-stage {
  position: relative;
  overflow: hidden;
}

.calendar-area {
  width: 100%;
  background: var(--bg-card2);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  box-sizing: border-box;
}

/* 当前月滑出 */
.slide-out-left {
  animation: slideOutLeft 0.3s ease forwards;
}
.slide-out-right {
  animation: slideOutRight 0.3s ease forwards;
}

/* 目标月滑入 */
.slide-in-left {
  position: absolute; top: 0; left: 0;
  animation: slideInLeft 0.3s ease forwards;
}
.slide-in-right {
  position: absolute; top: 0; left: 0;
  animation: slideInRight 0.3s ease forwards;
}

@keyframes slideOutLeft {
  from { transform: translateX(0); }
  to { transform: translateX(-100%); }
}
@keyframes slideOutRight {
  from { transform: translateX(0); }
  to { transform: translateX(100%); }
}
@keyframes slideInLeft {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}
@keyframes slideInRight {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}

.weekday-row {
  display: flex;
}
.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-dim);
  padding: 16rpx 0;
}
.day-grid {
  display: flex;
  flex-wrap: wrap;
}
.day-cell {
  width: calc(100% / 7);
  height: calc(100vw / 7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.day-cell.today {
  background: rgba(34,211,238,0.12);
}
.day-num {
  font-size: 28rpx;
  color: var(--text);
  position: relative;
  z-index: 1;
}
.day-cell.muted .day-num {
  color: var(--text-dim);
}

/* ── Checked day: bright green circle ── */
.day-cell.checked-bg::after {
  content: '';
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(52, 211, 153, 0.4);
  z-index: 0;
}
.checked-num {
  color: #34d399;
  font-weight: 700;
}

/* ── 补卡 ── */
.makeup-section {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
.btn-makeup {
  background: rgba(34,211,238,0.15);
  color: var(--accent);
  border: 1rpx solid rgba(34,211,238,0.25);
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 36rpx 36rpx;
  line-height: 1;
}

/* ── Title banner ── */
.title-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  padding: 20rpx 32rpx;
  background: rgba(251,191,36,0.08);
  border: 1rpx solid rgba(251,191,36,0.15);
  border-radius: 16rpx;
  gap: 12rpx;
}
.title-emoji {
  font-size: 40rpx;
}
.title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fbbf24;
}

.theme-light .title-banner {
  background: rgba(255,255,255,0.4);
  border-color: rgba(255,255,255,0.5);
}
.theme-light .title-text {
  color: #016B61;
  font-weight: 700;
}
.theme-light .btn-makeup {
  background: rgba(1,107,97,0.6);
  color: #fff;
  border-color: rgba(255,255,255,0.3);
  font-weight: 600;
}

/* ── Stats ── */
.stats-row {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 32rpx 24rpx;
  background: var(--bg-card2);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent);
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-top: 8rpx;
}

