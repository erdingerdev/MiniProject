.container {
  min-height: 100vh;
  background: #080b11;
  padding: 32rpx 48rpx;
}

.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e4e4e7;
}

/* ── 列表 ── */
.list {
  margin-top: 20rpx;
}
.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}
.rank-item.rank-0 {
  background: rgba(251,191,36,0.08);
  border-color: rgba(251,191,36,0.15);
}
.rank-item.rank-1 {
  background: rgba(148,163,184,0.06);
  border-color: rgba(148,163,184,0.12);
}
.rank-item.rank-2 {
  background: rgba(251,146,60,0.06);
  border-color: rgba(251,146,60,0.12);
}

.rank-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.rank-medal {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.rank-num {
  width: 60rpx;
  font-size: 26rpx;
  color: #52525b;
  text-align: center;
  flex-shrink: 0;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.rank-avatar.crown {
  border: 2rpx solid #fbbf24;
  width: 72rpx;
  height: 72rpx;
}
.rank-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.rank-avatar.placeholder::after {
  content: '👤';
  font-size: 24rpx;
  opacity: 0.3;
}

.rank-name {
  font-size: 28rpx;
  color: #e4e4e7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.rank-0 .rank-name {
  color: #fbbf24;
  font-weight: 600;
}

.rank-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #22d3ee;
  flex-shrink: 0;
}
.rank-0 .rank-count {
  color: #fbbf24;
  font-size: 32rpx;
}

/* ── 空 ── */
.empty {
  padding: 120rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 28rpx;
  color: #52525b;
}
