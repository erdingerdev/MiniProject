.container {
  min-height: 100vh;
  background: var(--bg-gradient, var(--bg));
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.container.theme-light { background: linear-gradient(160deg, #016B61 0%, #70B2B2 40%, #9ECFD4 70%, #E5E9C5 100%); }

/* 背景光球 */
.bg-layer { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.orb { position: absolute; border-radius: 50%; filter: blur(80rpx); opacity: 0.12; }
.orb-cyan { width: 400rpx; height: 400rpx; background: #06b6d4; top: -100rpx; right: -100rpx; }
.orb-purple { width: 300rpx; height: 300rpx; background: #8b5cf6; bottom: -80rpx; left: -80rpx; }

/* 自定义导航栏 */
.nav-bar { position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; width: 100%; height: 88rpx; margin-bottom: 20rpx; }
.nav-back { width: 64rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.nav-back-icon { font-size: 52rpx; color: #e0e0e0; }
.theme-light .nav-back-icon { color: #fff; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #e0e0e0; }
.theme-light .nav-title { color: #fff; }
.nav-placeholder { width: 64rpx; }

/* 中心布局 */
.center-box {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 600rpx;
  margin: 0 auto;
  padding-top: 80rpx;
}

.icon-lg { font-size: 96rpx; margin-bottom: 32rpx; }
.title { font-size: 40rpx; font-weight: 700; color: var(--text); margin-bottom: 16rpx; }
.hint { font-size: 26rpx; color: var(--text-dim); margin-bottom: 40rpx; text-align: center; line-height: 1.6; }

/* 按钮 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--accent), #3b82f6);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-top: 16rpx;
}
.btn-primary[disabled] { opacity: 0.4; }

/* 输入框 */
.input-code {
  width: 100%;
  height: 88rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border2);
  border-radius: 16rpx;
  color: var(--text);
  font-size: 30rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}

/* 头像选择 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.avatar-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(255,255,255,0.2);
  overflow: hidden;
}
.avatar-preview { width: 200rpx; height: 200rpx; border-radius: 50%; }
.avatar-empty {
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: var(--bg-card2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-plus { font-size: 48rpx; color: rgba(255,255,255,0.25); line-height: 1; }
.avatar-picker {
  position: absolute;
  top: 0; left: 0;
  width: 200rpx; height: 200rpx;
  padding: 0; margin: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  opacity: 0.01;
}
.avatar-picker::after { border: none; }
.avatar-hint { font-size: 24rpx; color: var(--text-dim); margin-top: 20rpx; text-align: center; }

/* 昵称区域 */
.field-group { width: 100%; margin-bottom: 16rpx; }
.field-label { font-size: 24rpx; color: var(--text-dim); margin-bottom: 12rpx; display: block; }
.nickname-input { text-align: center; }

/* 浅色模式 */
.theme-light .hint { color: rgba(255,255,255,0.75); }
.theme-light .field-label { color: rgba(255,255,255,0.75); }
.theme-light .avatar-hint { color: rgba(255,255,255,0.7); }
