<view class="container theme-{{theme}}">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack"><text class="nav-back-icon">‹</text></view>
    <text class="nav-title">后台管理</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- === 密码校验 === -->
  <view class="center-box" wx:if="{{!authed}}">
    <view class="icon-lg">🔐</view>
    <text class="hint">请输入管理密码</text>
    <input class="input-code" password placeholder="管理密码" value="{{adminPwd}}" bindinput="onPwdInput" maxlength="30"/>
    <button class="btn-primary" bindtap="doVerify" disabled="{{!adminPwd}}">验证</button>
    <text class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</text>
  </view>

  <!-- === 管理面板 === -->
  <block wx:else>
    <!-- Tab 导航 -->
    <view class="tabs">
      <view class="tab {{tab==='config'?'active':''}}" bindtap="switchTab" data-tab="config">配置</view>
      <view class="tab {{tab==='stations'?'active':''}}" bindtap="switchTab" data-tab="stations">站台</view>
      <view class="tab {{tab==='review'?'active':''}}" bindtap="switchTab" data-tab="review">审核</view>
      <view class="tab {{tab==='passcodes'?'active':''}}" bindtap="switchTab" data-tab="passcodes">通行码</view>
      <view class="tab {{tab==='users'?'active':''}}" bindtap="switchTab" data-tab="users">用户</view>
      <view class="tab {{tab==='logs'?'active':''}}" bindtap="switchTab" data-tab="logs">订单</view>
      <view class="tab {{tab==='feedbacks'?'active':''}}" bindtap="switchTab" data-tab="feedbacks">意见</view>
    </view>

    <!-- ====== 配置 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='config'}}">
      <!-- 新增通行码 -->
      <view class="section">
        <text class="section-title">新增通行码</text>
        <input class="field" placeholder="名称" value="{{newCodeName}}" bindinput="onNewCodeName"/>
        <view class="row">
          <view class="chip {{newCodeType==='exclusive'?'active':''}}" bindtap="setCodeType" data-type="exclusive">单人</view>
          <view class="chip {{newCodeType==='shared'?'active':''}}" bindtap="setCodeType" data-type="shared">多人</view>
          <view class="chip {{newCodeType==='disposable'?'active':''}}" bindtap="setCodeType" data-type="disposable">一次性</view>
        </view>
        <input class="field" placeholder="用量上限(0=无限)" value="{{newCodeMax}}" bindinput="onNewCodeMax" type="number"/>
        <picker class="field picker-field" mode="date" value="{{newCodeExpire}}" bindchange="onNewCodeExpire" end="2100-12-31">
          <view class="picker-text">{{newCodeExpire || '过期时间(留空=永久)'}}</view>
        </picker>
        <text class="field-tip" wx:if="{{newCodeExpire}}" bindtap="clearExpire">点击清除过期时间</text>
        <scroll-view class="cat-scroll" scroll-x enable-flex>
          <view class="cat-chip {{newCodeCategory===item?'active':''}}" wx:for="{{categories}}" wx:key="*this" bindtap="selectCategory" data-cat="{{item}}">{{item}}</view>
        </scroll-view>
        <button class="btn-sm" bindtap="doCreateCode" disabled="{{!newCodeName}}">创建通行码</button>
      </view>

      <!-- 分类管理 -->
      <view class="section">
        <text class="section-title">分类管理</text>
        <view class="cat-item" wx:for="{{categories}}" wx:key="*this" bindtap="onEditCategory" data-cat="{{item}}">
          <view class="cat-item-body">
            <text class="cat-item-name">{{item}}</text>
            <text class="cat-item-creds">账号: {{categoryCreds[item].username || '未设置'}} · 密码: {{categoryCreds[item].password || '未设置'}} · ¥{{categoryCreds[item].unitPrice || '22.98'}}</text>
          </view>
          <text class="cat-item-arrow">›</text>
        </view>
        <view class="empty" wx:if="{{categories.length===0}}">暂无分类</view>
        <button class="btn-sm" bindtap="onAddCategory" style="margin-top:16rpx">新增类型</button>
      </view>

      <!-- 开放开关 -->
      <view class="section">
        <text class="section-title">获取游泳票入口</text>
        <view class="switch-row">
          <text class="switch-label">{{swimEnabled ? '已开放' : '维护中'}}</text>
          <switch checked="{{swimEnabled}}" bindchange="toggleSwimEnabled" color="#22d3ee"/>
        </view>
        <text class="switch-hint" wx:if="{{!swimEnabled}}">关闭后用户点击获取游泳票将提示系统维护中</text>
      </view>

      <!-- 收款码 -->
      <view class="section">
        <text class="section-title">收款码</text>
        <image class="preview-qr" src="{{qrPreview}}" mode="widthFix" wx:if="{{qrPreview}}"/>
        <view class="qr-empty" wx:else>未上传</view>
        <button class="btn-sm" bindtap="pickQR">选择图片上传</button>
      </view>

      <!-- 管理密码 -->
      <view class="section">
        <text class="section-title">修改管理密码</text>
        <input class="field" password placeholder="新密码" value="{{newAdminPwd}}" bindinput="onNewAdminPwd"/>
        <button class="btn-sm btn-danger" bindtap="saveAdminPwd">更新管理密码</button>
      </view>
    </view>

    <!-- ====== 站台 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='stations'}}">
      <!-- 待审核站点 -->
      <view class="section" wx:if="{{stationRequests.length > 0}}">
        <text class="section-title">待审核站点 ({{stationRequests.length}})</text>
        <view class="review-item" wx:for="{{stationRequests}}" wx:key="_id">
          <view class="review-top">
            <text class="review-line">📍 {{item.name}}</text>
          </view>
          <view class="review-sub">{{item.nickname || '匿名'}} · {{item.createdAtFormatted}}</view>
          <view class="review-actions">
            <button class="btn-approve" bindtap="doReviewStation" data-id="{{item._id}}" data-action="approve">通过</button>
            <button class="btn-reject" bindtap="doReviewStation" data-id="{{item._id}}" data-action="reject">拒绝</button>
          </view>
        </view>
      </view>

      <view class="section">
        <text class="section-title">站台列表 ({{stations.length}})</text>
        <view class="station-item" wx:for="{{stations}}" wx:key="_id">
          <view class="station-info">
            <text class="station-name">{{item.name}}</text>
            <text class="station-dir" wx:if="{{item.direction}}">{{item.direction}}</text>
          </view>
          <view class="station-del" bindtap="doDeleteStation" data-id="{{item._id}}">×</view>
        </view>
        <view class="empty" wx:if="{{stations.length===0}}">暂无站台，点击右下角 + 添加</view>
      </view>

      <!-- 悬浮按钮 -->
      <view class="fab" bindtap="showStationSheet">
        <text class="fab-icon">+</text>
      </view>

      <!-- 添加站台弹窗 -->
      <view class="sheet-overlay" wx:if="{{showStationAdd}}" bindtap="hideStationSheet">
        <view class="sheet-card" catchtap="noop">
          <text class="sheet-title">添加站台</text>
          <input class="field" placeholder="站台名称（如 BRT双十中学站）" value="{{newStationName}}" bindinput="onStationNameInput"/>
          <input class="field" placeholder="方向（如 往岛内，选填）" value="{{newStationDir}}" bindinput="onStationDirInput"/>
          <button class="btn-sm" bindtap="doAddStation" disabled="{{!newStationName}}">确认添加</button>
          <button class="btn-sheet-close" bindtap="hideStationSheet">取消</button>
        </view>
      </view>
    </view>

    <!-- ====== 审核 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='review'}}">
      <view class="section">
        <text class="section-title">待审核路线 ({{reviewRoutes.length}})</text>
        <view class="review-item" wx:for="{{reviewRoutes}}" wx:key="_id">
          <view class="review-top">
            <view class="review-badge {{item.type === 'driver' ? 'badge-driver' : 'badge-passenger'}}">{{item.type === 'driver' ? '找人' : '找车'}}</view>
            <view class="review-line">{{item.nickname}} · {{item.origin}} → {{item.destination}}</view>
          </view>
          <view class="review-sub">出发时间 {{item.departTime}} · {{item.type === 'driver' ? '可乘人数' : '通勤人数'}} {{item.peopleCount}}人 · 联系方式 {{item.contact}}</view>
          <view class="review-sub" wx:if="{{item.note}}">备注 {{item.note}}</view>
          <view class="review-actions">
            <button class="btn-approve" bindtap="doReviewRoute" data-id="{{item._id}}" data-action="approve">通过</button>
            <button class="btn-reject" bindtap="doReviewRoute" data-id="{{item._id}}" data-action="reject">拒绝</button>
          </view>
        </view>
        <view class="empty" wx:if="{{reviewRoutes.length===0}}">暂无待审核路线</view>
      </view>

      <!-- 已审核 -->
      <view class="section">
        <text class="section-title">已审核路线</text>
        <view class="review-item done" wx:for="{{reviewedRoutes}}" wx:key="_id">
          <view class="review-top">
            <view class="review-badge {{item.type === 'driver' ? 'badge-driver' : 'badge-passenger'}}">{{item.type === 'driver' ? '找人' : '找车'}}</view>
            <view class="review-line">{{item.nickname}} · {{item.origin}} → {{item.destination}}</view>
          </view>
          <view class="review-sub">出发时间 {{item.departTime}} · {{item.status === 'approved' ? '已通过' : '已拒绝'}}</view>
          <view class="review-sub" wx:if="{{item.rejectReason}}">原因：{{item.rejectReason}}</view>
          <view class="review-actions">
            <button class="btn-reject" bindtap="doReviewRoute" data-id="{{item._id}}" data-action="delete">删除</button>
          </view>
        </view>
        <view class="empty" wx:if="{{reviewedRoutes.length===0}}">暂无</view>
      </view>
    </view>

    <!-- ====== 通行码 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='passcodes'}}">
      <!-- 列表 -->
      <view class="section">
        <text class="section-title">通行码列表 ({{totalPasscodes}})</text>
        <!-- 搜索 -->
        <view class="search-row">
          <input class="field search-input" placeholder="搜索通行码名称" value="{{codeSearchKey}}" bindinput="onCodeSearchInput" bindconfirm="onCodeSearchConfirm" confirm-type="search"/>
          <button class="btn-sm search-btn" bindtap="onCodeSearchConfirm">搜索</button>
        </view>
        <!-- 分类筛选 -->
        <scroll-view class="cat-scroll" scroll-x enable-flex style="margin-bottom:20rpx">
          <view class="cat-chip {{codeFilterCategory==='全部'?'active':''}}" catchtap="onFilterCodeCategory" data-cat="全部">全部</view>
          <view class="cat-chip {{codeFilterCategory===item?'active':''}}" wx:for="{{categories}}" wx:key="*this" catchtap="onFilterCodeCategory" data-cat="{{item}}">{{item}}</view>
        </scroll-view>
        <scroll-view class="order-scroll" scroll-y="true" style="height: calc(100vh - 420rpx)"
            bindscrolltolower="onPasscodeScrollToLower" lower-threshold="100">
        <view class="code-item" wx:for="{{passcodes}}" wx:key="id" wx:if="{{codeFilterCategory==='全部' || item.category===codeFilterCategory}}">
          <view class="code-info" bindtap="toggleCodeDetail" data-id="{{item.id}}">
            <view class="code-name-row">
              <text class="code-name">{{item.name}}</text>
              <text class="code-copy" catchtap="onCopyCodeName" data-name="{{item.name}}">复制</text>
            </view>
            <text class="code-meta">{{item.category||'swim'}} · {{item.type==='disposable'?'一次性':item.type==='shared'?'多人':'单人'}} · ¥{{item.unitPrice}} · 已用{{item.usageCount}}{{item.maxUses>0?'/'+item.maxUses:''}}次{{item.expireAt?' · '+item.expireAt+' 到期':' · 永久'}} · {{item.createdAt}} 创建</text>
          </view>
          <view class="code-del" bindtap="doDeleteCode" data-id="{{item.id}}" data-name="{{item.name}}">×</view>

          <!-- 展开详情 -->
          <view class="code-detail" wx:if="{{expandedId===item.id}}">
            <view class="detail-row-wrap" wx:for="{{codeDetail.boundUsers}}" wx:key="openid" wx:for-item="u">
              <view class="detail-row-delete" bindtap="onRemoveUser" data-openid="{{u.openid}}">移除</view>
              <view class="detail-row {{swipedUserId===u.openid?'swiped':''}}"
                    bindtouchstart="onDetailRowTouchStart"
                    bindtouchmove="onDetailRowTouchMove"
                    bindtouchend="onDetailRowTouchEnd"
                    data-openid="{{u.openid}}">
                <image class="u-avatar" src="{{u.avatar}}" mode="aspectFill" wx:if="{{u.avatar}}"/>
                <view class="u-avatar u-avatar-empty" wx:else></view>
                <view class="u-info">
                  <text class="u-name">{{u.nickname||'匿名'}}</text>
                  <text class="u-stats">总{{u.totalCount}}人次 · 近7天{{u.recent7Days}}人次 · 最近{{u.lastUsed||'无'}}</text>
                </view>
              </view>
            </view>
            <view class="detail-empty" wx:if="{{!codeDetail.boundUsers || codeDetail.boundUsers.length===0}}">
              暂无绑定用户
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{passcodes.length===0}}">还没有通行码</view>
        <view class="loading-tip" wx:if="{{passcodesLoading}}">加载中...</view>
        <view class="loading-tip" wx:elif="{{!passcodesHasMore && passcodes.length > 0}}">没有更多了</view>
        </scroll-view>
      </view>
    </view>

    <!-- ====== 用户 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='users'}}">
      <!-- 用户列表 -->
      <block wx:if="{{!checkinUser}}">
        <scroll-view class="order-scroll" scroll-y="true" style="height: calc(100vh - 240rpx)"
            bindscrolltolower="onUserScrollToLower" lower-threshold="100">
          <view class="section">
            <text class="section-title">用户列表 ({{totalUsers}})</text>
            <view class="user-item" wx:for="{{users}}" wx:key="openid" bindtap="showUserCheckins" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}">
              <image class="u-avatar" src="{{item.avatar}}" mode="aspectFill" wx:if="{{item.avatar}}"/>
              <view class="u-avatar u-avatar-empty" wx:else></view>
              <view class="u-info">
                <text class="u-name">{{item.nickname||'匿名'}}</text>
                <text class="u-stats">绑定: {{item.boundPasscodeName||'无'}} · 总{{item.totalCount}}人次</text>
              </view>
            </view>
            <view class="empty" wx:if="{{users.length===0}}">还没有用户</view>
            <view class="loading-tip" wx:if="{{usersLoading}}">加载中...</view>
            <view class="loading-tip" wx:elif="{{!usersHasMore && users.length > 0}}">没有更多了</view>
          </view>
        </scroll-view>
      </block>
      <!-- 打卡记录 -->
      <block wx:else>
        <view class="section">
          <view class="section-header">
            <text class="back-btn" bindtap="backToUsers">← 返回</text>
            <text class="section-title">{{checkinNickname}} 的打卡记录</text>
          </view>
          <scroll-view class="order-scroll" scroll-y="true" style="height: calc(100vh - 240rpx)"
              bindscrolltolower="onCheckinScrollToLower" lower-threshold="100">
            <view class="checkin-item" wx:for="{{checkins}}" wx:key="id">
              <view class="checkin-time">{{item.formattedTime}}</view>
              <view class="checkin-row">
                <text class="checkin-badge {{item.type==='manual' ? 'badge-manual' : ''}}">{{item.type==='manual' ? '补卡' : '支付'}}</text>
                <text wx:if="{{item.pool}}">{{item.pool}}</text>
                <text wx:if="{{item.passcodeName}}">「{{item.passcodeName}}」</text>
                <text>{{item.peopleCount}}人</text>
                <text wx:if="{{item.totalPrice}}">¥{{item.totalPrice}}</text>
              </view>
            </view>
            <view class="empty" wx:if="{{checkins.length===0}}">暂无打卡记录</view>
            <view class="loading-tip" wx:if="{{checkinsLoading}}">加载中...</view>
            <view class="loading-tip" wx:elif="{{!checkinsHasMore && checkins.length > 0}}">没有更多了</view>
          </scroll-view>
        </view>
      </block>
    </view>

    <!-- ====== 订单 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='logs'}}">
      <scroll-view class="order-scroll" scroll-y="true" style="height: calc(100vh - 200rpx)"
          bindscrolltolower="onOrderScrollToLower" lower-threshold="100">
        <view class="order-item" wx:for="{{orders}}" wx:key="id">
          <view class="order-time">{{item.formattedTime}}</view>
          <view class="order-row">
            <text class="order-user">{{item.nickname||'匿名'}}</text>
            <text class="order-badge {{item.type==='manual' ? 'badge-manual' : ''}}">{{item.type==='manual' ? '补卡' : '支付'}}</text>
          </view>
          <view class="order-row">
            <text class="order-pool">{{item.pool||item.passcodeName}}</text>
            <text class="order-code-name">「{{item.passcodeName}}」</text>
            <text class="order-people">{{item.peopleCount}}人</text>
          </view>
          <view class="order-amount" wx:if="{{item.totalPrice}}">¥{{item.totalPrice}} ({{item.unitPrice}}×{{item.peopleCount}})</view>
          <view class="order-cred" wx:if="{{item.username}}">账号: {{item.username}} / 密码: {{item.password}}</view>
        </view>
        <view class="empty" wx:if="{{orders.length===0}}">暂无订单</view>
        <view class="loading-tip" wx:if="{{ordersLoading}}">加载中...</view>
        <view class="loading-tip" wx:elif="{{!ordersHasMore && orders.length > 0}}">没有更多了</view>
      </scroll-view>
    </view>

    <!-- ====== 意见列表 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='feedbacks'}}">
      <scroll-view class="order-scroll" scroll-y="true" style="height: calc(100vh - 200rpx)"
          bindscrolltolower="onFeedbackScrollToLower" lower-threshold="100">
        <view class="feedback-item" wx:for="{{feedbacks}}" wx:key="id">
          <view class="feedback-row">
            <text class="feedback-user">{{item.nickname||'匿名'}}</text>
            <text class="feedback-time">{{item.createdAt}}</text>
          </view>
          <text class="feedback-content">{{item.content}}</text>
        </view>
        <view class="empty" wx:if="{{feedbacks.length===0}}">暂无意见</view>
        <view class="loading-tip" wx:if="{{feedbacksLoading}}">加载中...</view>
        <view class="loading-tip" wx:elif="{{!feedbacksHasMore && feedbacks.length > 0}}">没有更多了</view>
      </scroll-view>
    </view>
    <!-- 拒绝原因弹窗 -->
    <view class="modal-overlay" wx:if="{{showRejectModal}}" bindtap="hideRejectModal">
      <view class="modal-card" catchtap="noop">
        <text class="modal-title">填写拒绝原因</text>
        <input class="field" placeholder="拒绝原因（选填）" value="{{rejectReason}}" bindinput="onRejectReasonInput"/>
        <view class="modal-btns">
          <button class="btn-cancel" bindtap="hideRejectModal">取消</button>
          <button class="btn-confirm" bindtap="confirmReject">确认拒绝</button>
        </view>
      </view>
    </view>
  </block>
</view>
