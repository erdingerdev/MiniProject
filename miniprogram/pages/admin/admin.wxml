<view class="container theme-{{theme}}">

  <!-- === 密码校验 === -->
  <view class="center-box" wx:if="{{!authed}}">
    <view class="icon-lg">🔐</view>
    <text class="title">后台管理</text>
    <text class="hint">请输入管理密码</text>
    <input class="input-code" password placeholder="管理密码" value="{{adminPwd}}" bindinput="onPwdInput" maxlength="30"/>
    <button class="btn-primary" bindtap="doVerify" disabled="{{!adminPwd}}">验证</button>
    <text class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</text>
  </view>

  <!-- === 管理面板 === -->
  <block wx:else>
    <!-- Tab 导航 -->
    <view class="tabs">
      <view class="tab {{tab==='config'?'active':''}}" bindtap="switchTab" data-tab="config">配置</view>
      <view class="tab {{tab==='passcodes'?'active':''}}" bindtap="switchTab" data-tab="passcodes">通行码</view>
      <view class="tab {{tab==='users'?'active':''}}" bindtap="switchTab" data-tab="users">用户</view>
      <view class="tab {{tab==='logs'?'active':''}}" bindtap="switchTab" data-tab="logs">日志</view>
    </view>

    <!-- ====== 配置 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='config'}}">
      <!-- 开放开关 -->
      <view class="section">
        <text class="section-title">获取游泳票入口</text>
        <view class="switch-row">
          <text class="switch-label">{{swimEnabled ? '已开放' : '维护中'}}</text>
          <switch checked="{{swimEnabled}}" bindchange="toggleSwimEnabled" color="#22d3ee"/>
        </view>
        <text class="switch-hint" wx:if="{{!swimEnabled}}">关闭后用户点击获取游泳票将提示系统维护中</text>
      </view>

      <!-- 收款码 -->
      <view class="section">
        <text class="section-title">收款码</text>
        <image class="preview-qr" src="{{qrPreview}}" mode="widthFix" wx:if="{{qrPreview}}"/>
        <view class="qr-empty" wx:else>未上传</view>
        <button class="btn-sm" bindtap="pickQR">选择图片上传</button>
      </view>

      <!-- 引导文案 -->
      <view class="section">
        <text class="section-title">获取页面引导文案（换行用 \n）</text>
        <textarea class="field textarea-field" placeholder="引导文案" value="{{guideText}}" bindinput="onGuideText" maxlength="500"/>
        <button class="btn-sm" bindtap="saveGuideText">保存引导文案</button>
      </view>

      <!-- 管理密码 -->
      <view class="section">
        <text class="section-title">修改管理密码</text>
        <input class="field" password placeholder="新密码" value="{{newAdminPwd}}" bindinput="onNewAdminPwd"/>
        <button class="btn-sm btn-danger" bindtap="saveAdminPwd">更新管理密码</button>
      </view>
    </view>

    <!-- ====== 通行码 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='passcodes'}}">
      <!-- 分类管理 -->
      <view class="section">
        <text class="section-title">分类管理</text>
        <view class="cat-item" wx:for="{{categories}}" wx:key="*this" bindtap="onEditCategory" data-cat="{{item}}">
          <view class="cat-item-body">
            <text class="cat-item-name">{{item}}</text>
            <text class="cat-item-creds">账号: {{categoryCreds[item].username || '未设置'}} · 密码: {{categoryCreds[item].password || '未设置'}} · ¥{{categoryCreds[item].unitPrice || '22.98'}}</text>
          </view>
          <text class="cat-item-arrow">›</text>
        </view>
        <view class="empty" wx:if="{{categories.length===0}}">暂无分类</view>
        <button class="btn-sm" bindtap="onAddCategory" style="margin-top:16rpx">新增类型</button>
      </view>

      <!-- 新增 -->
      <view class="section">
        <text class="section-title">新增通行码</text>
        <input class="field" placeholder="名称" value="{{newCodeName}}" bindinput="onNewCodeName"/>
        <view class="row">
          <view class="chip {{newCodeType==='shared'?'active':''}}" bindtap="setCodeType" data-type="shared">多人</view>
          <view class="chip {{newCodeType==='exclusive'?'active':''}}" bindtap="setCodeType" data-type="exclusive">单人</view>
          <view class="chip {{newCodeType==='disposable'?'active':''}}" bindtap="setCodeType" data-type="disposable">一次性</view>
        </view>
        <input class="field" placeholder="用量上限(0=无限)" value="{{newCodeMax}}" bindinput="onNewCodeMax" type="number"/>
        <picker class="field picker-field" mode="date" value="{{newCodeExpire}}" bindchange="onNewCodeExpire" end="2100-12-31">
          <view class="picker-text">{{newCodeExpire || '过期时间(留空=永久)'}}</view>
        </picker>
        <text class="field-tip" wx:if="{{newCodeExpire}}" bindtap="clearExpire">点击清除过期时间</text>
        <!-- 分类选择 -->
        <scroll-view class="cat-scroll" scroll-x enable-flex>
          <view class="cat-chip {{newCodeCategory===item?'active':''}}" wx:for="{{categories}}" wx:key="*this" bindtap="selectCategory" data-cat="{{item}}">{{item}}</view>
        </scroll-view>
        <button class="btn-sm" bindtap="doCreateCode" disabled="{{!newCodeName}}">创建通行码</button>
      </view>

      <!-- 列表 -->
      <view class="section">
        <text class="section-title">通行码列表</text>
        <!-- 分类筛选 -->
        <scroll-view class="cat-scroll" scroll-x enable-flex style="margin-bottom:20rpx">
          <view class="cat-chip {{codeFilterCategory==='全部'?'active':''}}" bindtap="onFilterCodeCategory" data-cat="全部">全部</view>
          <view class="cat-chip {{codeFilterCategory===item?'active':''}}" wx:for="{{categories}}" wx:key="*this" bindtap="onFilterCodeCategory" data-cat="{{item}}">{{item}}</view>
        </scroll-view>
        <view class="code-item" wx:for="{{passcodes}}" wx:key="id" wx:if="{{codeFilterCategory==='全部' || item.category===codeFilterCategory}}">
          <view class="code-info" bindtap="toggleCodeDetail" data-id="{{item.id}}">
            <view class="code-name-row">
              <text class="code-name">{{item.name}}</text>
              <text class="code-copy" catchtap="onCopyCodeName" data-name="{{item.name}}">复制</text>
            </view>
            <text class="code-meta">{{item.category||'swim'}} · {{item.type==='disposable'?'一次性':item.type==='shared'?'多人':'单人'}} · ¥{{item.unitPrice}} · 已用{{item.usageCount}}{{item.maxUses>0?'/'+item.maxUses:''}}次{{item.expireAt?' · '+item.expireAt+' 到期':' · 永久'}} · {{item.createdAt}} 创建</text>
          </view>
          <view class="code-del" bindtap="doDeleteCode" data-id="{{item.id}}" data-name="{{item.name}}">×</view>

          <!-- 展开详情 -->
          <view class="code-detail" wx:if="{{expandedId===item.id}}">
            <view class="detail-row-wrap" wx:for="{{codeDetail.boundUsers}}" wx:key="openid" wx:for-item="u">
              <view class="detail-row-delete" bindtap="onRemoveUser" data-openid="{{u.openid}}">移除</view>
              <view class="detail-row {{swipedUserId===u.openid?'swiped':''}}"
                    bindtouchstart="onDetailRowTouchStart"
                    bindtouchmove="onDetailRowTouchMove"
                    bindtouchend="onDetailRowTouchEnd"
                    data-openid="{{u.openid}}">
                <image class="u-avatar" src="{{u.avatar}}" mode="aspectFill" wx:if="{{u.avatar}}"/>
                <view class="u-avatar u-avatar-empty" wx:else></view>
                <view class="u-info">
                  <text class="u-name">{{u.nickname||'匿名'}}</text>
                  <text class="u-stats">总{{u.totalCount}}人次 · 近7天{{u.recent7Days}}人次 · 最近{{u.lastUsed||'无'}}</text>
                </view>
              </view>
            </view>
            <view class="detail-empty" wx:if="{{!codeDetail.boundUsers || codeDetail.boundUsers.length===0}}">
              暂无绑定用户
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{passcodes.length===0}}">还没有通行码</view>
      </view>
    </view>

    <!-- ====== 用户 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='users'}}">
      <view class="section">
        <text class="section-title">用户列表 ({{users.length}})</text>
        <view class="user-item" wx:for="{{users}}" wx:key="openid">
          <image class="u-avatar" src="{{item.avatar}}" mode="aspectFill" wx:if="{{item.avatar}}"/>
          <view class="u-avatar u-avatar-empty" wx:else></view>
          <view class="u-info">
            <text class="u-name">{{item.nickname||'匿名'}}</text>
            <text class="u-stats">绑定: {{item.boundPasscodeName||'无'}} · 总{{item.totalCount}}人次 · 近7天{{item.recent7Days}}人次</text>
            <text class="u-stats">最近: {{item.lastUsed||'无记录'}}</text>
          </view>
        </view>
        <view class="empty" wx:if="{{users.length===0}}">还没有用户</view>
      </view>
    </view>

    <!-- ====== 日志 Tab ====== -->
    <view class="tab-content" wx:if="{{tab==='logs'}}">
      <view class="section">
        <text class="section-title">使用日志 (最近 20 条)</text>
        <view class="log-item" wx:for="{{logs}}" wx:key="id">
          <view class="log-time">{{item.formattedTime}}</view>
          <view class="log-body">
            <text class="log-user">{{item.nickname||'匿名'}}</text>
            <text class="log-code">使用「{{item.passcodeName}}」· {{item.peopleCount}}人</text>
          </view>
        </view>
        <view class="empty" wx:if="{{logs.length===0}}">暂无日志</view>
      </view>
    </view>
  </block>
</view>
