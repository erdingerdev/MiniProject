.container {
  min-height: 100vh;
  background: var(--bg-gradient, var(--bg));
  padding: 0 32rpx 32rpx;
}
.theme-light.container { background: linear-gradient(160deg, #016B61 0%, #70B2B2 40%, #9ECFD4 70%, #E5E9C5 100%); }

/* 导航栏 */
.nav-bar { position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; height: 88rpx; margin-bottom: 20rpx; }
.nav-back { width: 64rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.nav-back-icon { font-size: 52rpx; color: #e0e0e0; line-height: 1; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #e0e0e0; }
.nav-placeholder { width: 64rpx; }
.theme-light .nav-back-icon,
.theme-light .nav-title { color: #fff; }

/* ── 校验页 ── */
.center-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.icon-lg { font-size: 80rpx; margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.hint { font-size: 26rpx; color: var(--text-dim); margin-bottom: 40rpx; }
.input-code {
  width: 400rpx;
  height: 80rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border2);
  border-radius: 12rpx;
  color: var(--text);
  font-size: 30rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.btn-primary {
  width: 400rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--accent), #3b82f6);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.btn-primary[disabled] { opacity: 0.4; }
.error-msg { color: #f87171; font-size: 24rpx; margin-top: 16rpx; }

/* ── Tab 导航 ── */
.tabs {
  display: flex;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 32rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-dim);
  border-bottom: 3rpx solid transparent;
}
.tab.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
}

/* ── 开关 ── */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-label {
  font-size: 26rpx;
  color: var(--text);
}
.switch-hint {
  font-size: 22rpx;
  color: #f87171;
  margin-top: 12rpx;
  display: block;
}

/* ── Section ── */
.section {
  background: var(--bg-card);
  border: 1rpx solid var(--bg-input);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dim2);
  margin-bottom: 20rpx;
  display: block;
}

/* ── 表单 ── */
.field {
  width: 100%;
  height: 72rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border2);
  border-radius: 10rpx;
  color: var(--text);
  font-size: 26rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.textarea-field {
  height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}
.picker-field {
  display: flex;
  align-items: center;
}
/* ── 分类横向选择 ── */
.cat-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 16rpx;
  height: 64rpx;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: var(--bg-card2);
  color: var(--text-dim);
  border: 1rpx solid var(--border);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.cat-chip.active {
  background: var(--accent-bg);
  color: var(--accent);
  border-color: var(--accent-border);
}
.cat-chip.editing {
  opacity: 0.4;
  border-style: dashed;
  border-color: rgba(248,113,113,0.4);
}
.cat-add {
  width: 56rpx;
  padding: 0;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 300;
  color: var(--text-dim2);
  border-style: dashed;
}
.cat-add.active {
  background: var(--accent-bg);
  color: var(--accent);
  border-color: var(--accent-border);
}
.add-cat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.cat-input {
  flex: 1;
  margin-bottom: 0;
  height: 64rpx;
}
.add-cat-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.cat-btn {
  width: auto;
  padding: 0 24rpx;
  height: 64rpx;
  font-size: 24rpx;
}
.cat-btn-cancel {
  width: auto;
  padding: 0 24rpx;
  height: 64rpx;
  font-size: 24rpx;
  background: transparent;
  color: var(--text-dim);
  border: 1rpx solid var(--border2);
}

.picker-text {
  color: var(--text);
  font-size: 26rpx;
}
.picker-text:empty::before {
  content: attr(data-placeholder);
}
.field-tip {
  font-size: 22rpx;
  color: #f87171;
  text-align: center;
  display: block;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}
.btn-sm {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-bg);
  color: var(--accent);
  border-radius: 10rpx;
  font-size: 26rpx;
  border: 1rpx solid var(--accent-border);
}
.btn-sm[disabled] { opacity: 0.3; }
.btn-danger { background: var(--danger-bg); color: #f87171; border-color: var(--danger-border); }

/* ── 收款码预览 ── */
.preview-qr { width: 300rpx; border-radius: 12rpx; margin-bottom: 16rpx; }
.qr-empty {
  width: 300rpx; height: 300rpx;
  background: var(--bg-card2);
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-dim2); font-size: 24rpx; margin-bottom: 16rpx;
}

/* ── 类型选择 ── */
.row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.chip {
  flex: 1; text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  background: var(--bg-card2);
  color: var(--text-dim);
  border: 1rpx solid var(--border);
}
.chip.active { background: var(--accent-bg); color: var(--accent); border-color: var(--accent-border); }

/* ── 通行码/用户项 ── */
.code-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
  flex-wrap: wrap;
}
.code-info { flex: 1; min-width: 0; }
.code-name-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 4rpx; }
.code-name { font-size: 28rpx; color: var(--text); }
.code-copy {
  font-size: 20rpx;
  color: var(--accent);
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--accent-border);
  border-radius: 6rpx;
  flex-shrink: 0;
}
.code-meta { font-size: 22rpx; color: var(--text-dim2); display: block; margin-top: 4rpx; }
.code-del {
  width: 56rpx; height: 56rpx;
  line-height: 56rpx; text-align: center;
  font-size: 36rpx; color: #f87171; font-weight: 300;
}
.code-detail {
  width: 100%;
  margin-top: 12rpx;
  padding: 16rpx;
  background: var(--bg-card);
  border-radius: 10rpx;
}
.detail-row-wrap {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid var(--bg-card2);
}
.detail-row-wrap:last-child { border-bottom: none; }
.detail-row-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 120rpx;
  background: #ef4444;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
}
.detail-row, .user-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  position: relative;
  background: var(--bg-card);
  transition: transform 0.2s ease;
}
.detail-row.swiped {
  transform: translateX(-120rpx);
}
.detail-row:last-child, .user-item:last-child { border-bottom: none; }
.u-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--bg-input); margin-right: 16rpx;
}
.u-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.u-avatar-empty::after {
  content: '👤';
  font-size: 28rpx;
  opacity: 0.3;
}
.u-info { flex: 1; min-width: 0; }
.u-name { font-size: 26rpx; color: var(--text); display: block; }
.u-stats { font-size: 22rpx; color: var(--text-dim2); display: block; margin-top: 4rpx; }
.detail-empty { text-align: center; color: var(--text-dim2); font-size: 24rpx; padding: 24rpx; }
.empty { text-align: center; color: var(--text-dim2); font-size: 24rpx; padding: 40rpx; }

/* ── 分类列表 ── */
.cat-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--border);
}
.cat-item:last-child { border-bottom: none; }
.cat-item-body { flex: 1; min-width: 0; }
.cat-item-name {
  font-size: 28rpx;
  color: var(--text);
  display: block;
}
.cat-item-creds {
  font-size: 22rpx;
  color: var(--text-dim2);
  display: block;
  margin-top: 6rpx;
}
.cat-item-arrow {
  font-size: 36rpx;
  color: var(--text-dim2);
  margin-left: 12rpx;
}

/* ── 居中弹窗 ── */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--overlay);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-card {
  width: 580rpx;
  background: var(--modal-bg);
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  animation: modalIn 0.25s ease;
}
@keyframes modalIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  display: block;
  margin-bottom: 32rpx;
}

/* keep old cat-scroll/chip for passcode creation form */

/* ── 订单 ── */
.order-scroll {
  width: 100%;
}
.order-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.order-item:last-child { border-bottom: none; }
.order-time {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 8rpx;
}
.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}
.order-user {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.order-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: var(--accent);
  color: #fff;
}
.order-badge.badge-manual {
  background: var(--text-dim2);
}
.order-pool {
  font-size: 24rpx;
  color: var(--accent);
}
.order-people {
  font-size: 24rpx;
  color: var(--text-dim);
}
.order-amount {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-top: 4rpx;
}
.order-cred {
  font-size: 22rpx;
  color: var(--text-dim2);
  margin-top: 4rpx;
  word-break: break-all;
}
.loading-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-dim2);
  padding: 24rpx 0;
}

/* ── 搜索 ── */
.search-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
}
.search-btn {
  width: 120rpx;
  flex-shrink: 0;
}

/* ── 打卡记录 ── */
.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.back-btn {
  font-size: 28rpx;
  color: var(--accent);
  padding: 4rpx 8rpx;
}
.checkin-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.checkin-time {
  font-size: 22rpx;
  color: var(--text-dim2);
  margin-bottom: 6rpx;
}
.checkin-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  align-items: center;
  font-size: 26rpx;
  color: var(--text);
}
.checkin-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: var(--accent);
  color: #fff;
}
/* ── 意见列表 ── */
.feedback-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.feedback-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.feedback-user {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.feedback-time {
  font-size: 22rpx;
  color: var(--text-dim2);
}
.feedback-content {
  font-size: 26rpx;
  color: var(--text-dim);
  line-height: 1.6;
}

.checkin-badge.badge-manual {
  background: var(--text-dim2);
}

/* ── 审核管理 ── */
.review-item { padding: 24rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.review-item.done { opacity: 0.6; }
.review-top { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.review-badge { font-size: 24rpx; font-weight: 600; padding: 4rpx 14rpx; border-radius: 6rpx; flex-shrink: 0; }
.badge-driver { background: rgba(6,182,212,0.2); color: #06b6d4; }
.badge-passenger { background: rgba(251,191,36,0.2); color: #fbbf24; }
.review-line { font-size: 28rpx; color: #e0e0e0; }
.review-sub { font-size: 26rpx; color: #aaa; margin-bottom: 8rpx; }
.review-actions { display: flex; gap: 12rpx; margin-top: 10rpx; }
.btn-approve { background: rgba(52,211,153,0.15); color: #34d399; border: 1rpx solid rgba(52,211,153,0.3); font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 8rpx; }
.btn-reject { background: rgba(248,113,113,0.15); color: #f87171; border: 1rpx solid rgba(248,113,113,0.3); font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 8rpx; }

/* ── 站台管理 ── */
.station-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.station-info { display: flex; flex-direction: column; gap: 4rpx; }
.station-name { font-size: 28rpx; color: var(--text); }
.station-dir { font-size: 22rpx; color: var(--text-dim2); }
.station-del { font-size: 32rpx; color: #f87171; padding: 8rpx; }

/* 悬浮按钮 */
.fab { position: fixed; right: 40rpx; bottom: 80rpx; width: 96rpx; height: 96rpx; border-radius: 48rpx; background: #34d399; display: flex; align-items: center; justify-content: center; z-index: 50; box-shadow: 0 8rpx 24rpx rgba(52,211,153,0.3); }
.fab-icon { font-size: 48rpx; color: #1a1a1a; font-weight: 300; line-height: 1; }

/* 底部弹窗 */
.sheet-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 900; display: flex; align-items: flex-end; justify-content: center; }
.sheet-card { background: #1a1f2e; border-radius: 24rpx 24rpx 0 0; padding: 40rpx 32rpx; width: 100%; box-sizing: border-box; }
.sheet-title { font-size: 30rpx; font-weight: 600; color: #e0e0e0; text-align: center; display: block; margin-bottom: 24rpx; }
.btn-sheet-close { width: 100%; height: 80rpx; border: none; background: none; color: #888; font-size: 28rpx; display: flex; align-items: center; justify-content: center; margin-top: 16rpx; }

/* ── 拒绝原因弹窗 ── */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 900; display: flex; align-items: center; justify-content: center; }
.modal-card { background: #1a1f2e; border-radius: 20rpx; padding: 40rpx 32rpx; width: 580rpx; }
.modal-title { font-size: 30rpx; font-weight: 600; color: #e0e0e0; text-align: center; display: block; margin-bottom: 24rpx; }
.modal-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-cancel { flex: 1; height: 80rpx; background: rgba(255,255,255,0.06); color: #888; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; border: none; }
.btn-confirm { flex: 1; height: 80rpx; background: rgba(248,113,113,0.2); color: #f87171; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; border: none; }

/* 审核页浅色适配 */
.theme-light .review-line { color: #0a2a26; }
.theme-light .review-sub { color: #2a5a54; }
.theme-light .review-badge.badge-driver { background: rgba(6,182,212,0.3); color: #057a8c; }
.theme-light .review-badge.badge-passenger { background: rgba(251,191,36,0.3); color: #8a6300; }

/* ── 浅色模式渐变背景适配 ── */
.theme-light .tab { color: rgba(255,255,255,0.55); }
.theme-light .section-title { color: #333; }
.theme-light .sheet-card { background: #fff; }
.theme-light .sheet-title { color: #333; }
