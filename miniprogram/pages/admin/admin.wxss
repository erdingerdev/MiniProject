.container {
  min-height: 100vh;
  background: #080b11;
  padding: 32rpx;
}

/* ── 校验页 ── */
.center-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.icon-lg { font-size: 80rpx; margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #e4e4e7; margin-bottom: 12rpx; }
.hint { font-size: 26rpx; color: #71717a; margin-bottom: 40rpx; }
.input-code {
  width: 400rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 12rpx;
  color: #e4e4e7;
  font-size: 30rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.btn-primary {
  width: 400rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.btn-primary[disabled] { opacity: 0.4; }
.error-msg { color: #f87171; font-size: 24rpx; margin-top: 16rpx; }

/* ── Tab 导航 ── */
.tabs {
  display: flex;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
  margin-bottom: 32rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #71717a;
  border-bottom: 3rpx solid transparent;
}
.tab.active {
  color: #22d3ee;
  border-bottom-color: #22d3ee;
}

/* ── Section ── */
.section {
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #a1a1aa;
  margin-bottom: 20rpx;
  display: block;
}

/* ── 表单 ── */
.field {
  width: 100%;
  height: 72rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 10rpx;
  color: #e4e4e7;
  font-size: 26rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.textarea-field {
  height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}
.picker-field {
  display: flex;
  align-items: center;
}
.picker-text {
  color: #e4e4e7;
  font-size: 26rpx;
}
.picker-text:empty::before {
  content: attr(data-placeholder);
}
.field-tip {
  font-size: 22rpx;
  color: #f87171;
  text-align: center;
  display: block;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}
.btn-sm {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6,182,212,0.15);
  color: #22d3ee;
  border-radius: 10rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(6,182,212,0.25);
}
.btn-sm[disabled] { opacity: 0.3; }
.btn-danger { background: rgba(239,68,68,0.12); color: #f87171; border-color: rgba(239,68,68,0.2); }

/* ── 收款码预览 ── */
.preview-qr { width: 300rpx; border-radius: 12rpx; margin-bottom: 16rpx; }
.qr-empty {
  width: 300rpx; height: 300rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  color: #52525b; font-size: 24rpx; margin-bottom: 16rpx;
}

/* ── 类型选择 ── */
.row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.chip {
  flex: 1; text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.04);
  color: #71717a;
  border: 1rpx solid rgba(255,255,255,0.08);
}
.chip.active { background: rgba(6,182,212,0.15); color: #22d3ee; border-color: rgba(6,182,212,0.3); }

/* ── 通行码/用户项 ── */
.code-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  flex-wrap: wrap;
}
.code-info { flex: 1; min-width: 0; }
.code-name { font-size: 28rpx; color: #e4e4e7; display: block; }
.code-meta { font-size: 22rpx; color: #52525b; display: block; margin-top: 4rpx; }
.code-del {
  width: 56rpx; height: 56rpx;
  line-height: 56rpx; text-align: center;
  font-size: 36rpx; color: #f87171; font-weight: 300;
}
.code-detail {
  width: 100%;
  margin-top: 12rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 10rpx;
}
.detail-row, .user-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.detail-row:last-child, .user-item:last-child { border-bottom: none; }
.u-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(255,255,255,0.06); margin-right: 16rpx;
}
.u-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.u-avatar-empty::after {
  content: '👤';
  font-size: 28rpx;
  opacity: 0.3;
}
.u-info { flex: 1; min-width: 0; }
.u-name { font-size: 26rpx; color: #e4e4e7; display: block; }
.u-stats { font-size: 22rpx; color: #52525b; display: block; margin-top: 4rpx; }
.detail-empty { text-align: center; color: #52525b; font-size: 24rpx; padding: 24rpx; }
.empty { text-align: center; color: #52525b; font-size: 24rpx; padding: 40rpx; }

/* ── 日志 ── */
.log-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.log-item:last-child { border-bottom: none; }
.log-time {
  font-size: 22rpx;
  color: #52525b;
  margin-bottom: 6rpx;
}
.log-body {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.log-user {
  font-size: 26rpx;
  color: #e4e4e7;
}
.log-code {
  font-size: 26rpx;
  color: #22d3ee;
}
