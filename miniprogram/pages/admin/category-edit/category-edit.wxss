.container {
  min-height: 100vh;
  background: var(--bg-gradient, var(--bg));
  padding: 40rpx;
}

.form {
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 26rpx;
  color: var(--text-dim);
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border2);
  border-radius: 16rpx;
  color: var(--text);
  font-size: 30rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.btn-save {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-bg);
  color: var(--accent);
  border-radius: 16rpx;
  font-size: 30rpx;
  border: 1rpx solid rgba(6,182,212,0.25);
  margin-top: 48rpx;
}

.btn-delete {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(239,68,68,0.1);
  color: #f87171;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: 1rpx solid var(--danger-border);
  margin-top: 24rpx;
}
